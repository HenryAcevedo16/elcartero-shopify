{% comment %}
  ============================================================
  SNIPPET: product-benefits.liquid
  NAMESPACE: benefits
  
  Metafields requeridos (namespace "benefits"):
    - imagen_central      → file_reference
    - titulo              → single_line_text
    - descripcion_corta   → single_line_text
    - estadistica_1..4    → single_line_text  (formato: "número|etiqueta")
    - beneficio_1..6      → single_line_text  (formato: "svg_nombre|titulo|descripcion")
    - compatibilidad      → single_line_text  (lista separada por comas)

  Uso en main-product.liquid:
    {% if product.metafields.benefits.imagen_central != blank %}
      {% render 'product-benefits' %}
    {% endif %}
  ============================================================
{% endcomment %}

{% assign pb_img     = product.metafields.benefits.imagen_central %}
{% assign pb_titulo  = product.metafields.benefits.titulo %}
{% assign pb_desc    = product.metafields.benefits.descripcion_corta %}
{% assign pb_stat1   = product.metafields.benefits.estadistica_1 %}
{% assign pb_stat2   = product.metafields.benefits.estadistica_2 %}
{% assign pb_stat3   = product.metafields.benefits.estadistica_3 %}
{% assign pb_stat4   = product.metafields.benefits.estadistica_4 %}
{% assign pb_ben1    = product.metafields.benefits.beneficio_1 %}
{% assign pb_ben2    = product.metafields.benefits.beneficio_2 %}
{% assign pb_ben3    = product.metafields.benefits.beneficio_3 %}
{% assign pb_ben4    = product.metafields.benefits.beneficio_4 %}
{% assign pb_ben5    = product.metafields.benefits.beneficio_5 %}
{% assign pb_ben6    = product.metafields.benefits.beneficio_6 %}
{% assign pb_compat  = product.metafields.benefits.compatibilidad %}

{% if pb_img != blank %}

<style>
  /* ===== RESET Y VARIABLES ===== */
  .pb-wrap *,
  .pb-wrap *::before,
  .pb-wrap *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .pb-wrap {
    --pb-red:      #D62828;
    --pb-red-dark: #b31f1f;
    --pb-dark:     #12192B;
    --pb-white:    #ffffff;
    --pb-gray-50:  #F7F7F7;
    --pb-gray-100: #EFEFEF;
    --pb-gray-300: #D1D1D1;
    --pb-gray-500: #888888;
    --pb-radius:   16px;
    --pb-transition: 0.28s cubic-bezier(0.23, 1, 0.32, 1);

    font-family: 'Poppins', 'Inter', sans-serif;
    color: var(--pb-dark);
    width: 100%;
    margin: 48px 0 0;
  }

  /* ===== SECCIÓN LABEL ===== */
  .pb-section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pb-red);
    margin-bottom: 32px;
  }

  .pb-section-label::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background: var(--pb-red);
    border-radius: 2px;
    flex-shrink: 0;
  }

  /* ===== HERO ===== */
  .pb-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    background: var(--pb-white);
    border-radius: var(--pb-radius);
    padding: 40px;
    margin-bottom: 32px;
    box-shadow: 0 2px 24px rgba(0,0,0,0.06);
  }

  /* Imagen hero */
  .pb-hero-img-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pb-hero-img-circle {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 4px solid var(--pb-red);
    background: var(--pb-gray-50);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    box-shadow:
      0 0 0 8px rgba(214, 40, 40, 0.08),
      0 16px 48px rgba(214, 40, 40, 0.15);
    transition: box-shadow var(--pb-transition);
  }

  .pb-hero-img-circle:hover {
    box-shadow:
      0 0 0 12px rgba(214, 40, 40, 0.12),
      0 24px 64px rgba(214, 40, 40, 0.22);
  }

  .pb-hero-img-circle img {
    width: 88%;
    height: 88%;
    object-fit: contain;
    display: block;
  }

  /* Decorador punto rojo */
  .pb-hero-img-wrap::after {
    content: '';
    position: absolute;
    bottom: 10%;
    right: 8%;
    width: 18px;
    height: 18px;
    background: var(--pb-red);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(214,40,40,0.2);
  }

  /* Info hero */
  .pb-hero-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pb-hero-title {
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 800;
    color: var(--pb-dark);
    line-height: 1.15;
  }

  .pb-hero-desc {
    font-size: 15px;
    color: var(--pb-gray-500);
    line-height: 1.75;
  }

  /* Stats grid */
  .pb-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .pb-stat-card {
    background: var(--pb-gray-50);
    border: 1.5px solid var(--pb-gray-100);
    border-radius: 12px;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color var(--pb-transition), transform var(--pb-transition);
    cursor: default;
  }

  .pb-stat-card:hover {
    border-color: var(--pb-red);
    transform: translateY(-2px);
  }

  .pb-stat-num {
    font-size: 26px;
    font-weight: 800;
    color: var(--pb-red);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .pb-stat-label {
    font-size: 12px;
    color: var(--pb-gray-500);
    font-weight: 500;
    line-height: 1.3;
  }

  /* ===== BENEFITS GRID ===== */
  .pb-benefits-wrap {
    margin-bottom: 32px;
  }

  .pb-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .pb-benefit-card {
    background: var(--pb-white);
    border: 1.5px solid var(--pb-gray-100);
    border-radius: var(--pb-radius);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color var(--pb-transition),
      box-shadow var(--pb-transition),
      transform var(--pb-transition);
    cursor: default;
  }

  .pb-benefit-card:hover {
    border-color: var(--pb-red);
    box-shadow: 0 8px 28px rgba(214, 40, 40, 0.10);
    transform: translateY(-3px);
  }

  .pb-benefit-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--pb-gray-50);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background var(--pb-transition);
  }

  .pb-benefit-card:hover .pb-benefit-icon {
    background: rgba(214, 40, 40, 0.08);
  }

  .pb-benefit-icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--pb-dark);
    fill: none;
    transition: stroke var(--pb-transition);
  }

  .pb-benefit-card:hover .pb-benefit-icon svg {
    stroke: var(--pb-red);
  }

  .pb-benefit-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--pb-dark);
    line-height: 1.3;
  }

  .pb-benefit-desc {
    font-size: 13px;
    color: var(--pb-gray-500);
    line-height: 1.65;
  }

  /* ===== COMPATIBILITY BAR ===== */
  .pb-compat-bar {
    background: var(--pb-gray-50);
    border: 1.5px solid var(--pb-gray-100);
    border-radius: var(--pb-radius);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .pb-compat-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--pb-gray-500);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pb-compat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pb-compat-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--pb-white);
    border: 1.5px solid var(--pb-gray-300);
    border-radius: 99px;
    padding: 5px 13px;
    font-size: 12px;
    font-weight: 600;
    color: var(--pb-dark);
    transition:
      border-color var(--pb-transition),
      background var(--pb-transition),
      color var(--pb-transition);
    white-space: nowrap;
  }

  .pb-compat-chip::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--pb-gray-300);
    border-radius: 50%;
    transition: background var(--pb-transition);
  }

  .pb-compat-chip:hover {
    border-color: var(--pb-red);
    background: rgba(214, 40, 40, 0.05);
    color: var(--pb-red);
  }

  .pb-compat-chip:hover::before {
    background: var(--pb-red);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .pb-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .pb-hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px 20px;
    }

    .pb-hero-img-circle {
      max-width: 260px;
    }

    .pb-hero-img-wrap::after {
      right: calc(50% - 130px + 12px);
    }

    .pb-stats-grid {
      grid-template-columns: 1fr 1fr;
    }

    .pb-stat-num {
      font-size: 22px;
    }
  }

  @media (max-width: 480px) {
    .pb-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .pb-benefit-card {
      padding: 16px 14px;
      gap: 8px;
    }

    .pb-compat-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>

<div class="pb-wrap">

  <div class="pb-section-label">Beneficios del producto</div>

  <!-- ======================== HERO ======================== -->
  <div class="pb-hero">

    <!-- Imagen central -->
    <div class="pb-hero-img-wrap">
      <div class="pb-hero-img-circle">
        <img
          src="{{ pb_img | image_url: width: 800 }}"
          alt="{{ pb_titulo | default: product.title }}"
          width="800"
          height="800"
          loading="lazy"
        >
      </div>
    </div>

    <!-- Info derecha -->
    <div class="pb-hero-info">

      {% if pb_titulo != blank %}
        <h2 class="pb-hero-title">{{ pb_titulo }}</h2>
      {% else %}
        <h2 class="pb-hero-title">{{ product.title }}</h2>
      {% endif %}

      {% if pb_desc != blank %}
        <p class="pb-hero-desc">{{ pb_desc }}</p>
      {% endif %}

      <!-- Stats -->
      {% assign has_stats = false %}
      {% if pb_stat1 != blank or pb_stat2 != blank or pb_stat3 != blank or pb_stat4 != blank %}
        {% assign has_stats = true %}
      {% endif %}

      {% if has_stats %}
        <div class="pb-stats-grid">

          {% if pb_stat1 != blank %}
            {% assign s1 = pb_stat1 | split: '|' %}
            <div class="pb-stat-card">
              <div class="pb-stat-num">{{ s1[0] }}</div>
              <div class="pb-stat-label">{{ s1[1] }}</div>
            </div>
          {% endif %}

          {% if pb_stat2 != blank %}
            {% assign s2 = pb_stat2 | split: '|' %}
            <div class="pb-stat-card">
              <div class="pb-stat-num">{{ s2[0] }}</div>
              <div class="pb-stat-label">{{ s2[1] }}</div>
            </div>
          {% endif %}

          {% if pb_stat3 != blank %}
            {% assign s3 = pb_stat3 | split: '|' %}
            <div class="pb-stat-card">
              <div class="pb-stat-num">{{ s3[0] }}</div>
              <div class="pb-stat-label">{{ s3[1] }}</div>
            </div>
          {% endif %}

          {% if pb_stat4 != blank %}
            {% assign s4 = pb_stat4 | split: '|' %}
            <div class="pb-stat-card">
              <div class="pb-stat-num">{{ s4[0] }}</div>
              <div class="pb-stat-label">{{ s4[1] }}</div>
            </div>
          {% endif %}

        </div>
      {% endif %}

    </div>
  </div>
  <!-- /HERO -->

  <!-- ======================== BENEFITS GRID ======================== -->
  {% assign has_benefits = false %}
  {% if pb_ben1 != blank or pb_ben2 != blank or pb_ben3 != blank or pb_ben4 != blank or pb_ben5 != blank or pb_ben6 != blank %}
    {% assign has_benefits = true %}
  {% endif %}

  {% if has_benefits %}
    <div class="pb-benefits-wrap">
      <div class="pb-benefits-grid">

        {% assign pb_all_benefits = pb_ben1 | append: ';;;' | append: pb_ben2 | append: ';;;' | append: pb_ben3 | append: ';;;' | append: pb_ben4 | append: ';;;' | append: pb_ben5 | append: ';;;' | append: pb_ben6 %}
        {% assign pb_benefit_list = pb_all_benefits | split: ';;;' %}

        {% for pb_ben_raw in pb_benefit_list %}
          {% if pb_ben_raw != blank and pb_ben_raw != '' %}
            {% assign pb_parts = pb_ben_raw | split: '|' %}
            {% assign pb_icon_key = pb_parts[0] | strip %}
            {% assign pb_ben_tit  = pb_parts[1] | strip %}
            {% assign pb_ben_dsc  = pb_parts[2] | strip %}

            <div class="pb-benefit-card">

              <div class="pb-benefit-icon">
                <!-- Selección de ícono SVG según clave -->
                {% case pb_icon_key %}

                  {% when 'shield', 'garantia', 'seguridad', 'proteccion' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>

                  {% when 'battery', 'bateria', 'energia', 'carga' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="7" width="16" height="10" rx="2"/>
                      <line x1="22" y1="11" x2="22" y2="13"/>
                      <line x1="6" y1="11" x2="10" y2="11"/>
                      <line x1="8" y1="9" x2="8" y2="15"/>
                    </svg>

                  {% when 'headphones', 'audifonos', 'sonido', 'audio' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                      <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/>
                      <path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                    </svg>

                  {% when 'bluetooth', 'wifi', 'wireless', 'inalambrico' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6.5 6.5 17.5 17.5 12 23 12 1 17.5 6.5 6.5 17.5"/>
                    </svg>

                  {% when 'star', 'calidad', 'premium', 'excelencia' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>

                  {% when 'zap', 'rapido', 'velocidad', 'performance', 'rendimiento' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                    </svg>

                  {% when 'droplet', 'agua', 'resistente', 'waterproof', 'impermeable' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                    </svg>

                  {% when 'mic', 'microfono', 'voz', 'llamada' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                      <line x1="12" y1="19" x2="12" y2="23"/>
                      <line x1="8" y1="23" x2="16" y2="23"/>
                    </svg>

                  {% when 'volume', 'bass', 'grave', 'musica' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                      <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                      <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                    </svg>

                  {% when 'gift', 'regalo', 'oferta', 'promo' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 12 20 22 4 22 4 12"/>
                      <rect x="2" y="7" width="20" height="5"/>
                      <line x1="12" y1="22" x2="12" y2="7"/>
                      <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
                      <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
                    </svg>

                  {% when 'truck', 'envio', 'entrega', 'delivery', 'shipping' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="1" y="3" width="15" height="13"/>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>

                  {% when 'refresh', 'devolucion', 'garantia_devolucion', 'return' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="1 4 1 10 7 10"/>
                      <path d="M3.51 15a9 9 0 1 0 .49-3.09"/>
                    </svg>

                  {% when 'settings', 'configuracion', 'ajuste', 'gear' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="3"/>
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>

                  {% when 'smartphone', 'telefono', 'phone', 'movil', 'celular' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                      <line x1="12" y1="18" x2="12.01" y2="18"/>
                    </svg>

                  {% when 'heart', 'corazon', 'amor', 'favorito' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>

                  {% when 'check', 'verificado', 'aprobado', 'correcto' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>

                  {% when 'eye', 'vision', 'vista', 'diseño', 'design' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                      <circle cx="12" cy="12" r="3"/>
                    </svg>

                  {% when 'cpu', 'chip', 'procesador', 'tecnologia', 'tech' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="6" height="6"/>
                      <path d="M9 1v2M15 1v2M9 21v2M15 21v2M1 9h2M1 15h2M21 9h2M21 15h2"/>
                      <rect x="2" y="2" width="20" height="20" rx="2"/>
                    </svg>

                  {% when 'thermometer', 'temperatura', 'calor', 'frio', 'clima' %}
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
                    </svg>

                  {% else %}
                    <!-- Ícono genérico: check-circle -->
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                      <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                {% endcase %}
              </div>

              {% if pb_ben_tit != blank %}
                <div class="pb-benefit-title">{{ pb_ben_tit }}</div>
              {% endif %}

              {% if pb_ben_dsc != blank %}
                <div class="pb-benefit-desc">{{ pb_ben_dsc }}</div>
              {% endif %}

            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  {% endif %}
  <!-- /BENEFITS GRID -->

  <!-- ======================== COMPATIBILITY BAR ======================== -->
  {% if pb_compat != blank %}
    {% assign pb_chips = pb_compat | split: ',' %}
    {% if pb_chips.size > 0 %}
      <div class="pb-compat-bar">
        <span class="pb-compat-label">Compatible con</span>
        <div class="pb-compat-chips">
          {% for chip in pb_chips %}
            {% assign chip_clean = chip | strip %}
            {% if chip_clean != blank %}
              <span class="pb-compat-chip">{{ chip_clean }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endif %}
  <!-- /COMPATIBILITY BAR -->

</div>

{% endif %}
{% comment %} END: product-benefits.liquid {% endcomment %}
