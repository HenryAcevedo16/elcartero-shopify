{% comment %}
  ============================================================
  SNIPPET: product-benefits.liquid  (v2 — diseño tipo screenshot)
  NAMESPACE: benefits

  Metafields requeridos (namespace "benefits"):
    - imagen_central      → file_reference
    - titulo              → single_line_text
                           Formato con énfasis rojo: "Línea normal|Línea roja|Línea normal"
                           Si no hay pipes, se muestra todo el texto en negro.
    - descripcion_corta   → single_line_text
    - estadistica_1..4    → single_line_text  (formato: "número|etiqueta")
    - beneficio_1..6      → single_line_text  (formato: "icono_clave|titulo|descripcion")
    - compatibilidad      → single_line_text  (lista separada por comas)

  Uso en main-product.liquid:
    {% if product.metafields.benefits.imagen_central != blank %}
      {% render 'product-benefits' %}
    {% endif %}
  ============================================================
{% endcomment %}

{% assign pb_img     = product.metafields.benefits.imagen_central %}
{% if pb_img == blank %}{% assign pb_img = product.metafields.custom.benefits_imagen_central %}{% endif %}

{% assign pb_titulo  = product.metafields.benefits.titulo %}
{% if pb_titulo == blank %}{% assign pb_titulo = product.metafields.custom.benefits_titulo %}{% endif %}

{% assign pb_desc    = product.metafields.benefits.descripcion_corta %}
{% if pb_desc == blank %}{% assign pb_desc = product.metafields.custom.benefits_descripcion_corta %}{% endif %}

{% assign pb_stat1   = product.metafields.benefits.estadistica_1 %}
{% if pb_stat1 == blank %}{% assign pb_stat1 = product.metafields.custom.benefits_estadistica_1 %}{% endif %}

{% assign pb_stat2   = product.metafields.benefits.estadistica_2 %}
{% if pb_stat2 == blank %}{% assign pb_stat2 = product.metafields.custom.benefits_estadistica_2 %}{% endif %}

{% assign pb_stat3   = product.metafields.benefits.estadistica_3 %}
{% if pb_stat3 == blank %}{% assign pb_stat3 = product.metafields.custom.benefits_estadistica_3 %}{% endif %}

{% assign pb_stat4   = product.metafields.benefits.estadistica_4 %}
{% if pb_stat4 == blank %}{% assign pb_stat4 = product.metafields.custom.benefits_estadistica_4 %}{% endif %}

{% assign pb_ben1    = product.metafields.benefits.beneficio_1 %}
{% if pb_ben1 == blank %}{% assign pb_ben1 = product.metafields.custom.benefits_beneficio_1 %}{% endif %}

{% assign pb_ben2    = product.metafields.benefits.beneficio_2 %}
{% if pb_ben2 == blank %}{% assign pb_ben2 = product.metafields.custom.benefits_beneficio_2 %}{% endif %}

{% assign pb_ben3    = product.metafields.benefits.beneficio_3 %}
{% if pb_ben3 == blank %}{% assign pb_ben3 = product.metafields.custom.benefits_beneficio_3 %}{% endif %}

{% assign pb_ben4    = product.metafields.benefits.beneficio_4 %}
{% if pb_ben4 == blank %}{% assign pb_ben4 = product.metafields.custom.benefits_beneficio_4 %}{% endif %}

{% assign pb_ben5    = product.metafields.benefits.beneficio_5 %}
{% if pb_ben5 == blank %}{% assign pb_ben5 = product.metafields.custom.benefits_beneficio_5 %}{% endif %}

{% assign pb_ben6    = product.metafields.benefits.beneficio_6 %}
{% if pb_ben6 == blank %}{% assign pb_ben6 = product.metafields.custom.benefits_beneficio_6 %}{% endif %}

{% assign pb_compat  = product.metafields.benefits.compatibilidad %}
{% if pb_compat == blank %}{% assign pb_compat = product.metafields.custom.benefits_compatibilidad %}{% endif %}

{% if pb_img != blank %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');

  /* ===== RESET ===== */
  .pb-wrap *, .pb-wrap *::before, .pb-wrap *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .pb-wrap {
    --pb-red:      #D62828;
    --pb-red-light: rgba(214,40,40,0.08);
    --pb-dark:     #1a1a2e;
    --pb-white:    #ffffff;
    --pb-bg:       #F9F3F3;
    --pb-gray-50:  #F7F7F7;
    --pb-gray-100: #EFEFEF;
    --pb-gray-300: #D1D1D1;
    --pb-gray-500: #888888;
    --pb-radius:   16px;
    --pb-tr:       0.25s cubic-bezier(0.23, 1, 0.32, 1);

    font-family: 'Poppins', sans-serif;
    color: var(--pb-dark);
    width: 100%;
    margin: 48px 0 0;
  }

  /* ===== HERO ===== */
  .pb-hero {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 40px;
    align-items: center;
    background: var(--pb-white);
    border: 1.5px solid var(--pb-gray-100);
    border-radius: var(--pb-radius);
    padding: 32px;
    margin-bottom: 24px;
  }

  /* Imagen */
  .pb-hero-img-box {
    background: var(--pb-bg);
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pb-hero-img-box img {
    width: 85%;
    height: 85%;
    object-fit: contain;
    display: block;
  }

  /* Info */
  .pb-hero-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Badge */
  .pb-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--pb-red-light);
    color: var(--pb-red);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 99px;
    width: fit-content;
  }

  .pb-badge svg {
    width: 12px;
    height: 12px;
    fill: var(--pb-red);
    flex-shrink: 0;
  }

  /* Título */
  .pb-hero-title {
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 800;
    line-height: 1.18;
    color: var(--pb-dark);
  }

  .pb-hero-title .pb-red {
    color: var(--pb-red);
  }

  /* Descripción */
  .pb-hero-desc {
    font-size: 14px;
    color: var(--pb-gray-500);
    line-height: 1.75;
  }

  /* Stats row */
  .pb-stats-row {
    display: flex;
    gap: 0;
    border-top: 1.5px solid var(--pb-gray-100);
    padding-top: 16px;
    margin-top: 4px;
  }

  .pb-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 0 12px;
    border-right: 1.5px solid var(--pb-gray-100);
    text-align: center;
  }

  .pb-stat:first-child { padding-left: 0; }
  .pb-stat:last-child  { border-right: none; padding-right: 0; }

  .pb-stat-num {
    font-size: 22px;
    font-weight: 800;
    color: var(--pb-red);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .pb-stat-label {
    font-size: 10px;
    font-weight: 600;
    color: var(--pb-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  /* ===== BENEFITS SECTION ===== */
  .pb-benefits-section {
    margin-bottom: 24px;
  }

  .pb-section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pb-gray-500);
    margin-bottom: 14px;
  }

  .pb-benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .pb-benefit-card {
    background: var(--pb-white);
    border: 1.5px solid var(--pb-gray-100);
    border-radius: 12px;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition:
      border-color var(--pb-tr),
      box-shadow var(--pb-tr),
      transform var(--pb-tr);
    cursor: default;
  }

  .pb-benefit-card:hover {
    border-color: var(--pb-red);
    box-shadow: 0 6px 24px rgba(214,40,40,0.09);
    transform: translateY(-3px);
  }

  .pb-benefit-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--pb-red-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background var(--pb-tr);
  }

  .pb-benefit-card:hover .pb-benefit-icon {
    background: rgba(214,40,40,0.14);
  }

  .pb-benefit-icon svg {
    width: 20px;
    height: 20px;
    stroke: var(--pb-red);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pb-benefit-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--pb-dark);
    line-height: 1.3;
  }

  .pb-benefit-desc {
    font-size: 13px;
    color: var(--pb-gray-500);
    line-height: 1.65;
  }

  /* ===== COMPAT BAR ===== */
  .pb-compat-bar {
    background: var(--pb-gray-50);
    border: 1.5px solid var(--pb-gray-100);
    border-radius: var(--pb-radius);
    padding: 18px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .pb-compat-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pb-gray-500);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pb-compat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pb-compat-chip {
    display: inline-flex;
    align-items: center;
    background: var(--pb-white);
    border: 1.5px solid var(--pb-gray-300);
    border-radius: 99px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 500;
    color: var(--pb-dark);
    white-space: nowrap;
    transition: border-color var(--pb-tr), color var(--pb-tr);
  }

  .pb-compat-chip:hover {
    border-color: var(--pb-red);
    color: var(--pb-red);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .pb-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .pb-hero { grid-template-columns: 260px 1fr; gap: 28px; }
  }

  @media (max-width: 680px) {
    .pb-hero {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 20px;
    }
    .pb-hero-img-box { max-width: 280px; margin: 0 auto; width: 100%; }
    .pb-stat-num { font-size: 18px; }
    .pb-stat-label { font-size: 9px; }
    .pb-stat { padding: 0 8px; }
    .pb-compat-bar { flex-direction: column; align-items: flex-start; gap: 10px; }
  }

  @media (max-width: 480px) {
    .pb-benefits-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .pb-benefit-card { padding: 16px 12px; }
  }
</style>

<div class="pb-wrap">

  <!-- ======================== HERO ======================== -->
  <div class="pb-hero">

    <!-- Imagen izquierda -->
    <div class="pb-hero-img-box">
      <img
        src="{{ pb_img | image_url: width: 700 }}"
        alt="{{ pb_titulo | default: product.title }}"
        width="700"
        height="700"
        loading="lazy"
      >
    </div>

    <!-- Info derecha -->
    <div class="pb-hero-info">

      <!-- Badge -->
      <div class="pb-badge">
        <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Producto destacado
      </div>

      <!-- Título — soporta formato "línea 1|línea roja|línea 3" -->
      {% if pb_titulo != blank %}
        {% assign pb_titulo_parts = pb_titulo | split: '|' %}
        <h2 class="pb-hero-title">
          {% if pb_titulo_parts.size == 3 %}
            {{ pb_titulo_parts[0] }}<br>
            <span class="pb-red">{{ pb_titulo_parts[1] }}</span><br>
            {{ pb_titulo_parts[2] }}
          {% elsif pb_titulo_parts.size == 2 %}
            {{ pb_titulo_parts[0] }}<br>
            <span class="pb-red">{{ pb_titulo_parts[1] }}</span>
          {% else %}
            {{ pb_titulo }}
          {% endif %}
        </h2>
      {% else %}
        <h2 class="pb-hero-title">{{ product.title }}</h2>
      {% endif %}

      <!-- Descripción -->
      {% if pb_desc != blank %}
        <p class="pb-hero-desc">{{ pb_desc }}</p>
      {% endif %}

      <!-- Stats en fila -->
      {% assign has_stats = false %}
      {% if pb_stat1 != blank or pb_stat2 != blank or pb_stat3 != blank or pb_stat4 != blank %}
        {% assign has_stats = true %}
      {% endif %}

      {% if has_stats %}
        <div class="pb-stats-row">

          {% if pb_stat1 != blank %}
            {% assign s1 = pb_stat1 | split: '|' %}
            <div class="pb-stat">
              <div class="pb-stat-num">{{ s1[0] }}</div>
              <div class="pb-stat-label">{{ s1[1] }}</div>
            </div>
          {% endif %}

          {% if pb_stat2 != blank %}
            {% assign s2 = pb_stat2 | split: '|' %}
            <div class="pb-stat">
              <div class="pb-stat-num">{{ s2[0] }}</div>
              <div class="pb-stat-label">{{ s2[1] }}</div>
            </div>
          {% endif %}

          {% if pb_stat3 != blank %}
            {% assign s3 = pb_stat3 | split: '|' %}
            <div class="pb-stat">
              <div class="pb-stat-num">{{ s3[0] }}</div>
              <div class="pb-stat-label">{{ s3[1] }}</div>
            </div>
          {% endif %}

          {% if pb_stat4 != blank %}
            {% assign s4 = pb_stat4 | split: '|' %}
            <div class="pb-stat">
              <div class="pb-stat-num">{{ s4[0] }}</div>
              <div class="pb-stat-label">{{ s4[1] }}</div>
            </div>
          {% endif %}

        </div>
      {% endif %}

    </div>
  </div>
  <!-- /HERO -->

  <!-- ======================== BENEFITS GRID ======================== -->
  {% assign has_benefits = false %}
  {% if pb_ben1 != blank or pb_ben2 != blank or pb_ben3 != blank or pb_ben4 != blank or pb_ben5 != blank or pb_ben6 != blank %}
    {% assign has_benefits = true %}
  {% endif %}

  {% if has_benefits %}
    <div class="pb-benefits-section">
      <div class="pb-section-label">Lo que incluye</div>
      <div class="pb-benefits-grid">

        {% assign pb_all_benefits = pb_ben1 | append: ';;;' | append: pb_ben2 | append: ';;;' | append: pb_ben3 | append: ';;;' | append: pb_ben4 | append: ';;;' | append: pb_ben5 | append: ';;;' | append: pb_ben6 %}
        {% assign pb_benefit_list = pb_all_benefits | split: ';;;' %}

        {% for pb_ben_raw in pb_benefit_list %}
          {% if pb_ben_raw != blank and pb_ben_raw != '' %}
            {% assign pb_parts   = pb_ben_raw | split: '|' %}
            {% assign pb_icon_key = pb_parts[0] | strip %}
            {% assign pb_ben_tit  = pb_parts[1] | strip %}
            {% assign pb_ben_dsc  = pb_parts[2] | strip %}

            <div class="pb-benefit-card">

              <div class="pb-benefit-icon">
                {% case pb_icon_key %}

                  {% when 'shield','garantia','seguridad','proteccion' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>

                  {% when 'battery','bateria','energia','carga' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="7" width="16" height="10" rx="2"/><line x1="22" y1="11" x2="22" y2="13"/><line x1="6" y1="11" x2="10" y2="11"/><line x1="8" y1="9" x2="8" y2="15"/></svg>

                  {% when 'headphones','audifonos','sonido','audio' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>

                  {% when 'bluetooth','wifi','wireless','inalambrico' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="6.5 6.5 17.5 17.5 12 23 12 1 17.5 6.5 6.5 17.5"/></svg>

                  {% when 'star','calidad','premium','excelencia' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>

                  {% when 'zap','rapido','velocidad','performance','rendimiento' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>

                  {% when 'droplet','agua','resistente','waterproof','impermeable' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>

                  {% when 'mic','microfono','voz','llamada' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>

                  {% when 'volume','bass','grave','musica' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>

                  {% when 'gift','regalo','oferta','promo' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>

                  {% when 'truck','envio','entrega','delivery','shipping' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>

                  {% when 'refresh','devolucion','return' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.09"/></svg>

                  {% when 'settings','configuracion','ajuste','gear' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>

                  {% when 'smartphone','telefono','phone','movil','celular' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>

                  {% when 'heart','corazon','amor','favorito' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>

                  {% when 'layers','altura','niveles','ajuste_altura' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>

                  {% when 'wind','ventilacion','frio','aire','cooling' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>

                  {% when 'minimize','plegar','plegable','compact' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="10" y1="14" x2="21" y2="3"/><line x1="3" y1="21" x2="14" y2="10"/></svg>

                  {% when 'monitor','pantalla','screen','display' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>

                  {% when 'cpu','chip','procesador','tecnologia','tech' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="6" height="6"/><path d="M9 1v2M15 1v2M9 21v2M15 21v2M1 9h2M1 15h2M21 9h2M21 15h2"/><rect x="2" y="2" width="20" height="20" rx="2"/></svg>

                  {% when 'check','verificado','correcto','aprobado' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>

                  {% when 'eye','vision','universal','compatibilidad' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>

                  {% else %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>

                {% endcase %}
              </div>

              {% if pb_ben_tit != blank %}
                <div class="pb-benefit-title">{{ pb_ben_tit }}</div>
              {% endif %}

              {% if pb_ben_dsc != blank %}
                <div class="pb-benefit-desc">{{ pb_ben_dsc }}</div>
              {% endif %}

            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  {% endif %}
  <!-- /BENEFITS GRID -->

  <!-- ======================== COMPATIBILITY BAR ======================== -->
  {% if pb_compat != blank %}
    {% assign pb_chips = pb_compat | split: ',' %}
    {% if pb_chips.size > 0 %}
      <div class="pb-compat-bar">
        <span class="pb-compat-label">Compatible con</span>
        <div class="pb-compat-chips">
          {% for chip in pb_chips %}
            {% assign chip_clean = chip | strip %}
            {% if chip_clean != blank %}
              <span class="pb-compat-chip">{{ chip_clean }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endif %}
  <!-- /COMPAT BAR -->

</div>

{% endif %}
{% comment %} END product-benefits.liquid v2 {% endcomment %}
