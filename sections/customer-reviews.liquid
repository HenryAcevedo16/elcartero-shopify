<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  .ecr-reviews-section {
    --red: #d62828;
    --dark: #12192b;
    --white: #ffffff;
    --gray-50: #f9f9f9;
    --gray-100: #f2f2f2;
    --gray-300: #d1d1d1;
    --gray-500: #888;
    --gray-700: #444;
    --star: #f5a623;
    --radius: 16px;

    font-family: 'Figtree', sans-serif;
    background: var(--white);
    color: var(--dark);
    padding: 60px 20px 80px;
  }
  .ecr-reviews-section *,
  .ecr-reviews-section *::before,
  .ecr-reviews-section *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Header */
  .ecr-section-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 10px;
  }
  .ecr-section-label::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background: var(--red);
    border-radius: 2px;
  }
  .ecr-section-title {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 800;
    color: var(--dark);
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .ecr-section-title span {
    color: var(--red);
  }
  .ecr-section-sub {
    font-size: 14px;
    color: var(--gray-500);
    margin-bottom: 36px;
  }

  /* Summary */
  .ecr-summary {
    display: flex;
    align-items: center;
    gap: 28px;
    background: var(--gray-50);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius);
    padding: 20px 28px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .ecr-summary-score {
    text-align: center;
    min-width: 70px;
  }
  .ecr-summary-score .ecr-big {
    font-size: 44px;
    font-weight: 800;
    color: var(--dark);
    line-height: 1;
  }
  .ecr-summary-score .ecr-stars-row {
    margin: 4px 0 2px;
  }
  .ecr-summary-score .ecr-count {
    font-size: 12px;
    color: var(--gray-500);
  }
  .ecr-summary-divider {
    width: 1px;
    height: 56px;
    background: var(--gray-300);
  }
  .ecr-summary-bars {
    flex: 1;
    min-width: 200px;
  }
  .ecr-bar-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
  }
  .ecr-bar-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--gray-700);
    width: 16px;
    text-align: right;
  }
  .ecr-bar-track {
    flex: 1;
    height: 5px;
    background: var(--gray-100);
    border-radius: 99px;
    overflow: hidden;
  }
  .ecr-bar-fill {
    height: 100%;
    background: var(--star);
    border-radius: 99px;
    transition: width 0.8s ease;
  }
  .ecr-bar-count {
    font-size: 11px;
    color: var(--gray-500);
    width: 20px;
  }
  .ecr-summary-badge {
    background: var(--dark);
    color: var(--white);
    border-radius: 12px;
    padding: 14px 20px;
    text-align: center;
    min-width: 130px;
  }
  .ecr-summary-badge .ecr-badge-num {
    font-size: 22px;
    font-weight: 800;
    display: block;
  }
  .ecr-summary-badge .ecr-badge-text {
    font-size: 11px;
    opacity: 0.6;
    margin-top: 2px;
  }

  /* Stars */
  .ecr-stars {
    display: flex;
    gap: 2px;
  }
  .ecr-star {
    font-size: 14px;
    color: var(--gray-300);
  }
  .ecr-star.ecr-filled {
    color: var(--star);
  }

  /* Grid */
  .ecr-reviews-grid {
    columns: 3;
    column-gap: 16px;
  }
  @media (max-width: 900px) {
    .ecr-reviews-grid {
      columns: 2;
    }
  }
  @media (max-width: 540px) {
    .ecr-reviews-grid {
      columns: 1;
    }
  }

  /* Card */
  .ecr-card {
    break-inside: avoid;
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 16px;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    cursor: default;
  }
  .ecr-card:hover {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.09);
    transform: translateY(-3px);
  }
  .ecr-card-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: var(--gray-100);
  }
  .ecr-card-photo-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--gray-100);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    color: var(--gray-300);
  }
  .ecr-card-body {
    padding: 16px;
  }
  .ecr-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .ecr-card-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--red);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ecr-card-meta {
    flex: 1;
    margin-left: 10px;
  }
  .ecr-card-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1.2;
  }
  .ecr-card-date {
    font-size: 11px;
    color: var(--gray-500);
    margin-top: 1px;
  }
  .ecr-verified {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 10px;
    font-weight: 600;
    color: #16a34a;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 3px 7px;
    border-radius: 99px;
    white-space: nowrap;
  }
  .ecr-card-stars {
    margin-bottom: 8px;
  }
  .ecr-card-product {
    font-size: 11px;
    font-weight: 600;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }
  .ecr-card-text {
    font-size: 13px;
    color: var(--gray-700);
    line-height: 1.6;
  }

  /* Write Review Button */
  .ecr-write-wrap {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 24px;
  }
  .ecr-btn-write {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--white);
    color: var(--dark);
    border: 2px solid var(--dark);
    font-family: 'Figtree', sans-serif;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ecr-btn-write:hover {
    background: var(--dark);
    color: #fff;
  }

  /* Modal */
  .ecr-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .ecr-modal-overlay.ecr-open {
    display: flex;
  }
  .ecr-modal {
    background: #fff;
    border-radius: 20px;
    padding: 32px;
    width: 100%;
    max-width: 480px;
    position: relative;
    animation: ecrPopIn 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }
  @keyframes ecrPopIn {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(16px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .ecr-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--gray-100);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray-700);
  }
  .ecr-modal-title {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 6px;
  }
  .ecr-modal-sub {
    font-size: 13px;
    color: var(--gray-500);
    margin-bottom: 24px;
  }
  .ecr-field-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dark);
    margin-bottom: 6px;
    display: block;
  }
  .ecr-field-input,
  .ecr-field-textarea {
    width: 100%;
    font-family: 'Figtree', sans-serif;
    font-size: 14px;
    border: 1.5px solid var(--gray-300);
    border-radius: 10px;
    padding: 11px 14px;
    margin-bottom: 16px;
    outline: none;
    transition: border-color 0.2s;
  }
  .ecr-field-input:focus,
  .ecr-field-textarea:focus {
    border-color: var(--dark);
  }
  .ecr-field-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .ecr-star-picker {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
  }
  .ecr-star-pick {
    font-size: 28px;
    cursor: pointer;
    color: var(--gray-300);
    transition: color 0.15s, transform 0.15s;
    line-height: 1;
  }
  .ecr-star-pick.ecr-active,
  .ecr-star-pick:hover {
    color: var(--star);
    transform: scale(1.15);
  }

  .ecr-upload-area {
    border: 2px dashed var(--gray-300);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    cursor: pointer;
    margin-bottom: 20px;
    transition: border-color 0.2s, background 0.2s;
  }
  .ecr-upload-area:hover {
    border-color: var(--dark);
    background: var(--gray-50);
  }
  .ecr-upload-icon {
    font-size: 28px;
    margin-bottom: 6px;
  }
  .ecr-upload-text {
    font-size: 13px;
    color: var(--gray-500);
  }
  .ecr-upload-text strong {
    color: var(--dark);
  }
  #ecr-photo-input {
    display: none;
  }
  .ecr-upload-preview {
    display: none;
    width: 80px;
    height: 80px;
    border-radius: 10px;
    object-fit: cover;
    margin: 0 auto 8px;
  }

  .ecr-btn-submit {
    width: 100%;
    background: var(--red);
    color: #fff;
    font-family: 'Figtree', sans-serif;
    font-size: 15px;
    font-weight: 700;
    padding: 14px;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .ecr-btn-submit:hover {
    background: #b31f1f;
    transform: translateY(-1px);
  }
</style>

<div class="ecr-reviews-section">
  <!-- HEADER -->
  <div class="ecr-section-label">Opiniones verificadas</div>
  <div style="display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:4px;">
    <div>
      <h2 class="ecr-section-title">{{ section.settings.titulo }}</h2>
      <p class="ecr-section-sub">{{ section.settings.subtitulo }}</p>
    </div>
    <div class="ecr-write-wrap" style="margin-bottom:0;">
      <button class="ecr-btn-write" onclick="ecrOpenModal()">✏️ Escribir reseña</button>
    </div>
  </div>

  <!-- SUMMARY -->
  <div class="ecr-summary">
    <div class="ecr-summary-score">
      <div class="ecr-big">{{ section.settings.puntuacion }}</div>
      <div class="ecr-stars-row">
        <div class="ecr-stars">
          {% assign score_floor = section.settings.puntuacion | floor %}
          {% for i in (1..5) %}
            {% if i <= score_floor %}
              <span class="ecr-star ecr-filled">★</span>
            {% else %}
              <span class="ecr-star">★</span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="ecr-count">de 5</div>
    </div>
    <div class="ecr-summary-divider"></div>
    <div class="ecr-summary-bars">
      {% assign total_reviews = section.settings.total_resenas | default: 50 %}
      <div class="ecr-bar-row">
        <span class="ecr-bar-label">5</span>
        <div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:82%"></div></div>
        <span class="ecr-bar-count">{{ total_reviews | times: 0.82 | round }}</span>
      </div>
      <div class="ecr-bar-row">
        <span class="ecr-bar-label">4</span>
        <div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:12%"></div></div>
        <span class="ecr-bar-count">{{ total_reviews | times: 0.12 | round }}</span>
      </div>
      <div class="ecr-bar-row">
        <span class="ecr-bar-label">3</span>
        <div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:4%"></div></div>
        <span class="ecr-bar-count">{{ total_reviews | times: 0.04 | round }}</span>
      </div>
      <div class="ecr-bar-row">
        <span class="ecr-bar-label">2</span>
        <div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:2%"></div></div>
        <span class="ecr-bar-count">{{ total_reviews | times: 0.02 | round }}</span>
      </div>
      <div class="ecr-bar-row">
        <span class="ecr-bar-label">1</span>
        <div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:0%"></div></div>
        <span class="ecr-bar-count">0</span>
      </div>
    </div>
    <div class="ecr-summary-divider"></div>
    <div class="ecr-summary-badge">
      <span class="ecr-badge-num">{{ section.settings.porcentaje_satisfaccion }}%</span>
      <div class="ecr-badge-text">clientes satisfechos</div>
    </div>
  </div>

  <!-- GRID -->
  <div class="ecr-reviews-grid">
    {% for block in section.blocks %}
      <div class="ecr-card" {{ block.shopify_attributes }}>
        {% if block.settings.imagen %}
          <img
            class="ecr-card-photo"
            src="{{ block.settings.imagen | image_url: width: 400 }}"
            alt="Reseña de {{ block.settings.nombre }}"
            width="400"
            height="400"
            loading="lazy"
          >
        {% else %}
          <div class="ecr-card-photo-placeholder">📦</div>
        {% endif %}

        <div class="ecr-card-body">
          <div class="ecr-card-top">
            {% assign initial1 = block.settings.nombre | slice: 0 | upcase %}
            {% assign parts = block.settings.nombre | split: ' ' %}
            {% assign initial2 = '' %}
            {% if parts.size > 1 %}
              {% assign initial2 = parts[1] | slice: 0 | upcase %}
            {% endif %}
            <div class="ecr-card-avatar">
              {{ initial1 -}}
              {{- initial2 }}
            </div>
            <div class="ecr-card-meta">
              <div class="ecr-card-name">{{ block.settings.nombre }}</div>
              <div class="ecr-card-date">{{ block.settings.fecha }}</div>
            </div>
            <span class="ecr-verified">✓ Verificado</span>
          </div>
          <div class="ecr-card-stars ecr-stars">
            {% for i in (1..5) %}
              {% if i <= block.settings.estrellas %}
                <span class="ecr-star ecr-filled">★</span>
              {% else %}
                <span class="ecr-star">★</span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="ecr-card-product">{{ block.settings.producto }}</div>
          <p class="ecr-card-text">{{ block.settings.texto }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<!-- MODAL -->
<div class="ecr-modal-overlay" id="ecr-modal-overlay" onclick="ecrHandleOverlayClick(event)">
  <div class="ecr-modal">
    <button class="ecr-modal-close" onclick="ecrCloseModal()">✕</button>
    <div class="ecr-modal-title">Comparte tu experiencia</div>
    <p class="ecr-modal-sub">Tu reseña ayuda a otros clientes a tomar la mejor decisión.</p>

    <div
      id="ecr-submit-error"
      style="display:none; color:#D62828; font-size:13px; font-weight:600; text-align:center; margin-bottom:16px; background:#fef2f2; padding:10px; border-radius:8px; border:1px solid #fecaca;"
    ></div>

    <label class="ecr-field-label">Tu calificación</label>
    <div class="ecr-star-picker" id="ecr-star-picker">
      <span class="ecr-star-pick" data-val="1" onclick="ecrSetStars(1)">☆</span>
      <span class="ecr-star-pick" data-val="2" onclick="ecrSetStars(2)">☆</span>
      <span class="ecr-star-pick" data-val="3" onclick="ecrSetStars(3)">☆</span>
      <span class="ecr-star-pick" data-val="4" onclick="ecrSetStars(4)">☆</span>
      <span class="ecr-star-pick" data-val="5" onclick="ecrSetStars(5)">☆</span>
    </div>

    <label class="ecr-field-label">Tu nombre</label>
    <input class="ecr-field-input" id="ecr-input-name" type="text" placeholder="Ej. María Rodríguez">

    <label class="ecr-field-label">Producto comprado</label>
    <input
      class="ecr-field-input"
      id="ecr-input-product"
      type="text"
      value="{{ product.title | escape }}"
      readonly
      style="background-color: var(--gray-50); cursor: not-allowed; color: var(--gray-700);"
    >

    <label class="ecr-field-label">Tu reseña</label>
    <textarea
      class="ecr-field-textarea"
      id="ecr-input-text"
      placeholder="Cuéntanos tu experiencia con el producto y la entrega..."
    ></textarea>

    <label class="ecr-field-label">Foto (opcional)</label>
    <div class="ecr-upload-area" onclick="document.getElementById('ecr-photo-input').click()">
      <img class="ecr-upload-preview" id="ecr-upload-preview" src="{{ 'favicon.svg' | asset_url }}" alt="Vista previa" width="80" height="80" loading="lazy">
      <div class="ecr-upload-icon">📷</div>
      <div class="ecr-upload-text">
        <strong>Toca para subir una foto</strong><br>
        JPG o PNG, máx. 5MB
      </div>
    </div>
    <input type="file" id="ecr-photo-input" accept="image/*" onchange="ecrPreviewPhoto(event)">

    <button class="ecr-btn-submit" onclick="ecrSubmitReview()">Publicar reseña</button>
  </div>
</div>

<script>
  let ecrSelectedStars = 0;

  function ecrOpenModal() {
    document.getElementById('ecr-modal-overlay').classList.add('ecr-open');
    document.body.style.overflow = 'hidden';
  }

  function ecrCloseModal() {
    document.getElementById('ecr-modal-overlay').classList.remove('ecr-open');
    document.body.style.overflow = '';
  }

  function ecrHandleOverlayClick(e) {
    if (e.target === document.getElementById('ecr-modal-overlay')) ecrCloseModal();
  }

  function ecrSetStars(val) {
    ecrSelectedStars = val;
    document.querySelectorAll('.ecr-star-pick').forEach((s) => {
      const isActive = parseInt(s.dataset.val) <= val;
      s.classList.toggle('ecr-active', isActive);
      s.textContent = isActive ? '★' : '☆';
    });
  }

  function ecrPreviewPhoto(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const img = document.getElementById('ecr-upload-preview');
      img.src = ev.target.result;
      img.style.display = 'block';
      document.querySelector('.ecr-upload-icon').style.display = 'none';
    };
    reader.readAsDataURL(file);
  }

  const CLOUDINARY_URL = 'https://api.cloudinary.com/v1_1/dpcza3euo/image/upload';
  const CLOUDINARY_PRESET = 'naa15md7';
  const SUPABASE_URL = 'https://dbtuzdfejaakbuuoumse.supabase.co/rest/v1/Reviews';
  const SUPABASE_KEY = 'sb_publishable_JL0Rq_GjdJZclca_xv22Dg_UqArwoIz';

  async function ecrSubmitReview() {
    const errorEl = document.getElementById('ecr-submit-error');
    errorEl.style.display = 'none';

    const nombre = document.getElementById('ecr-input-name').value.trim();
    const producto = document.getElementById('ecr-input-product').value.trim();
    const texto = document.getElementById('ecr-input-text').value.trim();
    const photoInput = document.getElementById('ecr-photo-input');
    const file = photoInput.files[0];

    if (!nombre || !producto || !texto || ecrSelectedStars === 0) {
      errorEl.textContent = 'Por favor, completa todos los campos obligatorios y tu calificación.';
      errorEl.style.display = 'block';
      return;
    }

    const btn = document.querySelector('.ecr-btn-submit');
    btn.textContent = 'Enviando...';
    btn.style.opacity = '0.7';
    btn.style.cursor = 'not-allowed';
    btn.disabled = true;

    try {
      let foto_url = null;

      // Subir foto a Cloudinary si hay
      if (file) {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('upload_preset', CLOUDINARY_PRESET);

        const cloudRes = await fetch(CLOUDINARY_URL, {
          method: 'POST',
          body: formData,
        });
        const cloudData = await cloudRes.json();

        if (cloudData.secure_url) {
          foto_url = cloudData.secure_url;
        } else {
          throw new Error('Error al subir la imagen.');
        }
      }

      // Guardar en Supabase
      const reviewData = {
        nombre: nombre,
        producto: producto,
        estrellas: ecrSelectedStars,
        texto: texto,
        foto_url: foto_url,
        verificado: false,
      };

      const supaRes = await fetch(SUPABASE_URL, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: 'Bearer ' + SUPABASE_KEY,
          'Content-Type': 'application/json',
          Prefer: 'return=minimal',
        },
        body: JSON.stringify(reviewData),
      });

      if (!supaRes.ok) throw new Error('Error al guardar la reseña en la base de datos.');

      // Exito
      alert('¡Gracias por tu reseña! La revisaremos pronto 🎉');

      // Limpiar form
      document.getElementById('ecr-input-name').value = '';
      document.getElementById('ecr-input-text').value = '';
      photoInput.value = '';
      document.getElementById('ecr-upload-preview').style.display = 'none';
      document.querySelector('.ecr-upload-icon').style.display = 'block';
      ecrSetStars(0);

      ecrCloseModal();
    } catch (err) {
      errorEl.textContent = 'Hubo un error al enviar tu reseña. Intenta nuevamente.';
      errorEl.style.display = 'block';
    } finally {
      btn.textContent = 'Publicar reseña';
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
      btn.disabled = false;
    }
  }
</script>

