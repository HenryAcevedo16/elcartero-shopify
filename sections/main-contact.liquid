<div class="contact-page-wrapper">
  <div class="breadcrumb" style="padding: 0 0 20px 0; margin: 0;">
    <a href="{{ routes.root_url }}" style="color:#666; text-decoration:none; font-size:0.9rem;">Inicio</a
    ><span style="margin: 0 8px; color:#999; font-size:0.9rem;">›</span>
    <span class="current" style="font-weight:600; color:#111; font-size:0.9rem;">Contacto</span>
  </div>

  <section class="wrap" style="padding: 0 0 80px 0;">
    <div class="contact-layout-grid">
      <!-- Lado Izquierdo: Textos y Cards -->
      <div class="contact-layout-left">
        <div class="contact-inner-left" style="display:flex; flex-direction:column; gap:40px;">
        
          <div class="reveal">
          <p style="color:#DC2626; font-weight:700; font-size:1.1rem; margin-bottom:12px;">¿Tienes alguna duda?</p>
          <h1 style="font-size:3rem; font-weight:800; line-height:1.1; color:#111; letter-spacing:-1px; margin:0;">
            Estamos disponibles para ayudarte y responder tus preguntas
          </h1>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px;">
          <!-- WhatsApp -->
          <a
            href="https://wa.me/18093269319"
            target="_blank"
            rel="noopener"
            class="trust-chip reveal"
            style="padding:24px; border-radius:12px; background:#F8FAFC; text-decoration:none; color:inherit; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
          >
            <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path><path d="M9 12h.01"></path><path d="M12 12h.01"></path><path d="M15 12h.01"></path>
              </svg>
            </span>
            <div>
              <div style="font-weight:800; font-size:1rem; margin-bottom:4px; color:#111;">WhatsApp</div>
              <div style="color:#64748B; font-size:.9rem; line-height:1.4;">
                Respuesta rápida<br>
                +1 (809) 326-9319
              </div>
            </div>
          </a>

          <!-- Email -->
          <a
            href="mailto:soporte@elcarterord.store"
            class="trust-chip reveal d1"
            style="padding:24px; border-radius:12px; background:#F8FAFC; text-decoration:none; color:inherit; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
          >
            <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <div>
              <div style="font-weight:800; font-size:1rem; margin-bottom:4px; color:#111;">Email</div>
              <div style="color:#64748B; font-size:.9rem; line-height:1.4;">
                Respondemos en 24h<br>
                soporte@elcarterord.store
              </div>
            </div>
          </a>

          <!-- Horario de atención -->
          <div
            class="trust-chip reveal d2"
            style="padding:24px; border-radius:12px; background:#F8FAFC; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
          >
            <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            <div>
              <div style="font-weight:800; font-size:1rem; margin-bottom:4px; color:#111;">Horario de atención</div>
              <div style="color:#64748B; font-size:.9rem; line-height:1.4;">
                Lun-Sáb: 9am-7pm<br>
                Dom: 10am-4pm
              </div>
            </div>
          </div>

          <!-- Redes sociales -->
          <div
            class="trust-chip reveal d3"
            style="padding:24px; border-radius:12px; background:#F8FAFC; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
          >
            <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
            </span>
            <div style="width: 100%;">
              <div style="font-weight:800; font-size:1rem; margin-bottom:12px; color:#111;">Redes sociales</div>
              <div style="display:flex; gap:16px; align-items:center;">
                <a
                  href="https://wa.me/18093269319"
                  style="color:#64748B; display:flex; align-items:center; text-decoration:none; transition: color 0.2s;"
                  onmouseover="this.style.color='#25D366'"
                  onmouseout="this.style.color='#64748B'"
                  title="WhatsApp"
                >
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                </a>
                <a
                  href="#"
                  style="color:#64748B; display:flex; align-items:center; text-decoration:none; transition: color 0.2s;"
                  onmouseover="this.style.color='#E1306C'"
                  onmouseout="this.style.color='#64748B'"
                  title="Instagram"
                >
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </a>
                <a
                  href="#"
                  style="color:#64748B; display:flex; align-items:center; text-decoration:none; transition: color 0.2s;"
                  onmouseover="this.style.color='#1877F2'"
                  onmouseout="this.style.color='#64748B'"
                  title="Facebook"
                >
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>

      <!-- Lado Derecho: Formulario -->
      <div class="form-section reveal contact-layout-right" style="padding:0;">
        <div class="contact-inner-right">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div style="text-align:center; padding:40px 20px; background:#F8FAFC; border-radius:16px;">
              <div style="font-size:3.5rem; margin-bottom:16px;">✅</div>
              <h3 style="font-weight:800; color:#065f46; margin-bottom:12px; font-size:1.5rem;">¡Mensaje enviado!</h3>
              <p style="color:#64748B; font-size:1rem; line-height:1.6;">
                Gracias por escribirnos. Te responderemos lo antes posible por email o WhatsApp.
              </p>
            </div>

          {% else %}
            {% if form.errors %}
              <div style="background:#fef2f2; border:1px solid #fca5a5; border-radius:12px; padding:16px 20px; margin-bottom:24px; font-size:.9rem; color:#991b1b;">
                Por favor revisa los campos marcados en rojo.
              </div>
            {% endif %}

            <div style="display: flex; flex-direction: column; gap: 24px;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; width: 100%;">
                <div class="form-group">
                  <label
                    class="form-label"
                    for="ContactName"
                    style="font-weight:800; font-size:.85rem; margin-bottom:8px; display:block; color:#111; text-transform:uppercase; letter-spacing:0.5px;"
                    >Nombre</label
                  >
                  <input
                    class="form-inp"
                    type="text"
                    id="ContactName"
                    name="contact[name]"
                    value="{{ customer.name }}"
                    style="background:#EEF2F6; border:none; border-radius:50px; padding:14px 16px; width:100%; font-size:.95rem; font-weight:500; color:#111; outline:none; transition: box-shadow 0.2s;"
                    onfocus="this.style.boxShadow='0 0 0 2px #dc2626'; this.style.background='#fff'"
                    onblur="this.style.boxShadow='none'; this.style.background='#EEF2F6'"
                  >
                </div>
                <div class="form-group">
                  <label
                    class="form-label"
                    for="ContactLastName"
                    style="font-weight:800; font-size:.85rem; margin-bottom:8px; display:block; color:#111; text-transform:uppercase; letter-spacing:0.5px;"
                    >Apellido</label
                  >
                  <input
                    class="form-inp"
                    type="text"
                    id="ContactLastName"
                    name="contact[apellido]"
                    style="background:#EEF2F6; border:none; border-radius:50px; padding:14px 16px; width:100%; font-size:.95rem; font-weight:500; color:#111; outline:none; transition: box-shadow 0.2s;"
                    onfocus="this.style.boxShadow='0 0 0 2px #dc2626'; this.style.background='#fff'"
                    onblur="this.style.boxShadow='none'; this.style.background='#EEF2F6'"
                  >
                </div>
              </div>

              <div class="form-group">
                <label
                  class="form-label"
                  for="ContactEmail"
                  style="font-weight:800; font-size:.85rem; margin-bottom:8px; display:block; color:#111; text-transform:uppercase; letter-spacing:0.5px;"
                >
                  Correo electrónico
                </label>
                <input
                  class="form-inp"
                  type="email"
                  id="ContactEmail"
                  name="contact[email]"
                  value="{{ customer.email }}"
                  required
                  style="background:#EEF2F6; border:none; border-radius:50px; padding:14px 16px; width:100%; font-size:.95rem; font-weight:500; color:#111; outline:none; transition: box-shadow 0.2s;"
                  onfocus="this.style.boxShadow='0 0 0 2px #dc2626'; this.style.background='#fff'"
                  onblur="this.style.boxShadow='none'; this.style.background='#EEF2F6'"
                >
              </div>

              <div class="form-group">
                <label
                  class="form-label"
                  style="font-weight:800; font-size:.85rem; margin-bottom:16px; display:block; color:#111; text-transform:uppercase; letter-spacing:0.5px;"
                  >Tipo de duda</label
                >
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                  <label style="display:flex; align-items:center; gap:10px; font-size:.95rem; cursor:pointer; color:#475569;">
                    <input
                      type="radio"
                      name="contact[tipo_de_duda]"
                      value="Estado de mi pedido"
                      style="width:18px; height:18px; accent-color:#111; cursor:pointer;"
                      required
                    >
                    Estado de mi pedido
                  </label>
                  <label style="display:flex; align-items:center; gap:10px; font-size:.95rem; cursor:pointer; color:#475569;">
                    <input
                      type="radio"
                      name="contact[tipo_de_duda]"
                      value="Devoluciones"
                      style="width:18px; height:18px; accent-color:#111; cursor:pointer;"
                    >
                    Devoluciones
                  </label>
                  <label style="display:flex; align-items:center; gap:10px; font-size:.95rem; cursor:pointer; color:#475569;">
                    <input
                      type="radio"
                      name="contact[tipo_de_duda]"
                      value="Información de producto"
                      style="width:18px; height:18px; accent-color:#111; cursor:pointer;"
                    >
                    Información de producto
                  </label>
                  <label style="display:flex; align-items:center; gap:10px; font-size:.95rem; cursor:pointer; color:#475569;">
                    <input
                      type="radio"
                      name="contact[tipo_de_duda]"
                      value="Otra consulta"
                      style="width:18px; height:18px; accent-color:#111; cursor:pointer;"
                    >
                    Otra consulta
                  </label>
                </div>
              </div>

              <div class="form-group">
                <label
                  class="form-label"
                  for="ContactBody"
                  style="font-weight:800; font-size:.85rem; margin-bottom:8px; display:block; color:#111; text-transform:uppercase; letter-spacing:0.5px;"
                >
                  Cuéntanos sobre tus dudas
                </label>
                <textarea
                  class="form-textarea"
                  id="ContactBody"
                  name="contact[body]"
                  required
                  style="min-height:140px; background:#EEF2F6; border:none; border-radius:10px; padding:16px; width:100%; font-size:.95rem; font-weight:500; color:#111; outline:none; resize:vertical; transition: box-shadow 0.2s;"
                  onfocus="this.style.boxShadow='0 0 0 2px #dc2626'; this.style.background='#fff'"
                  onblur="this.style.boxShadow='none'; this.style.background='#EEF2F6'"
                ></textarea>
              </div>
            </div>

            <button
              type="submit"
              style="width:100%; margin-top:32px; background:#111; color:#fff; font-size:1.05rem; font-weight:800; padding:16px; border-radius:12px; border:none; cursor:pointer; transition:transform 0.2s, background 0.2s; display:flex; justify-content:center; align-items:center; gap:10px;"
              onmouseover="this.style.background='#dc2626'"
              onmouseout="this.style.background='#111'"
            >
              Enviar mensaje
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
          {% endif %}
        {% endform %}
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .contact-page-wrapper {
    max-width: 100%;
    margin: 0;
    padding: 100px 0 0;
  }
  .contact-layout-grid {
    display: flex;
    width: 100%;
    align-items: flex-start;
  }
  .contact-layout-left {
    width: 50%;
    padding-left: 48px;
    padding-right: 48px;
  }
  .contact-layout-right {
    width: 50%;
    padding-left: 24px;
    padding-right: 48px;
  }
  .contact-inner-left {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .contact-inner-right {
    max-width: 600px;
  }
  @media (max-width: 960px) {
    .contact-page-wrapper {
      padding: 100px 0 0;
    }
    .contact-layout-grid {
      flex-direction: column;
      gap: 60px;
    }
    .contact-layout-left,
    .contact-layout-right {
      width: 100%;
      padding-left: 20px;
      padding-right: 20px;
    }
    .contact-inner-left,
    .contact-inner-right {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp",
      "label": "Número de WhatsApp",
      "default": "+1 (809) 326-9319"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Correo de contacto",
      "default": "soporte@elcarterord.store"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Horario de atención",
      "default": "Lun–Sáb: 9am–7pm\nDom: 10am–4pm"
    }
  ]
}
{% endschema %}
