<div class="contact-page-wrapper">
  <div class="breadcrumb contact-breadcrumb" style="margin: 0;">
    <a href="{{ routes.root_url }}" style="color:#666; text-decoration:none; font-size:0.9rem;">Inicio</a
    ><span style="margin: 0 8px; color:#999; font-size:0.9rem;">›</span>
    <span class="current" style="font-weight:600; color:#111; font-size:0.9rem;">Contacto</span>
  </div>

  <section class="wrap" style="padding: 0 0 80px 0;">
    <div class="contact-layout-grid">
      <!-- Lado Izquierdo: Textos y Cards -->
      <div class="contact-layout-left">
        <div class="contact-inner-left" style="display:flex; flex-direction:column; gap:40px;">
          <div class="reveal">
            <p style="color:#DC2626; font-weight:700; font-size:24px; margin-top:14px; margin-bottom:12px;">
              ¿Tienes alguna duda?
            </p>
            <h1 style="font-size:64px; font-weight:800; line-height:1.1; color:#111; letter-spacing:-1px; margin:0;">
              Estamos disponibles para ayudarte y responder tus preguntas
            </h1>
          </div>

          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px;">
            <!-- WhatsApp -->
            <a
              href="https://wa.me/18093269319"
              target="_blank"
              rel="noopener"
              class="trust-chip reveal"
              style="padding:24px; border-radius:12px; background:#F8FAFC; text-decoration:none; color:inherit; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
            >
              <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path><path d="M9 12h.01"></path><path d="M12 12h.01"></path><path d="M15 12h.01"></path>
                </svg>
              </span>
              <div>
                <div style="font-weight:800; font-size:1rem; margin-bottom:4px; color:#111;">Número de contacto</div>
                <div style="color:#64748B; font-size:.9rem; line-height:1.4;">
                  Respuesta rápida<br>
                  +1 (809) 326-9319
                </div>
              </div>
            </a>

            <!-- Email -->
            <a
              href="mailto:soporte@elcarterord.store"
              class="trust-chip reveal d1"
              style="padding:24px; border-radius:12px; background:#F8FAFC; text-decoration:none; color:inherit; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
            >
              <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </span>
              <div>
                <div style="font-weight:800; font-size:1rem; margin-bottom:4px; color:#111;">Correo electrónico</div>
                <div style="color:#64748B; font-size:.9rem; line-height:1.4;">
                  Respondemos en 24h<br>
                  soporte@elcarterord.store
                </div>
              </div>
            </a>

            <!-- Horario de atención -->
            <div
              class="trust-chip reveal d2"
              style="padding:24px; border-radius:12px; background:#F8FAFC; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
            >
              <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </span>
              <div>
                <div style="font-weight:800; font-size:1rem; margin-bottom:4px; color:#111;">Horario de atención</div>
                <div style="color:#64748B; font-size:.9rem; line-height:1.4;">
                  Lun-Sáb: 9am-7pm<br>
                  Dom: 10am-4pm
                </div>
              </div>
            </div>

            <!-- Redes sociales -->
            <div
              class="trust-chip reveal d3"
              style="padding:24px; border-radius:12px; background:#F8FAFC; display:flex; gap:16px; align-items:flex-start; transition: all 0.2s;"
            >
              <span style="display:flex; align-items:center; justify-content:center; color:#111; padding-top:2px;">
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
              </span>
              <div style="width: 100%;">
                <div style="font-weight:800; font-size:1rem; margin-bottom:12px; color:#111;">Redes sociales</div>
                <div style="display:flex; gap:16px; align-items:center;">
                  <a
                    href="https://wa.me/18093269319"
                    style="color:#64748B; display:flex; align-items:center; text-decoration:none; transition: color 0.2s;"
                    onmouseover="this.style.color='#25D366'"
                    onmouseout="this.style.color='#64748B'"
                    title="WhatsApp"
                  >
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  </a>
                  <a
                    href="#"
                    style="color:#64748B; display:flex; align-items:center; text-decoration:none; transition: color 0.2s;"
                    onmouseover="this.style.color='#E1306C'"
                    onmouseout="this.style.color='#64748B'"
                    title="Instagram"
                  >
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                  </a>
                  <a
                    href="#"
                    style="color:#64748B; display:flex; align-items:center; text-decoration:none; transition: color 0.2s;"
                    onmouseover="this.style.color='#1877F2'"
                    onmouseout="this.style.color='#64748B'"
                    title="Facebook"
                  >
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Lado Derecho: Bloques de Información -->
      <div class="reveal contact-layout-right" style="padding:0;">
        <div
          class="contact-inner-right"
          style="display: flex; flex-direction: column; justify-content: space-between; gap: 16px; flex: 1;"
        >
          <!-- General -->
          <div class="faq-row">
            <div class="faq-icon-box active">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
              <span>General</span>
            </div>
            <div class="faq-text-box">
              <h3>Información General</h3>
              <p>
                Encuentra respuestas rápidas sobre cómo funciona nuestra tienda, la disponibilidad de los productos y
                cómo contactarnos de forma directa.
              </p>
            </div>
          </div>

          <!-- Pagos -->
          <div class="faq-row">
            <div class="faq-icon-box">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line>
              </svg>
              <span>Pagos</span>
            </div>
            <div class="faq-text-box">
              <h3>Métodos de pago</h3>
              <p>
                Aceptamos tarjetas de crédito, transferencias bancarias y efectivo contra entrega. Tus transacciones
                están 100% protegidas.
              </p>
            </div>
          </div>

          <!-- Devoluciones -->
          <div class="faq-row">
            <div class="faq-icon-box">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 14 4 9 9 4"></polyline><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path>
              </svg>
              <span>Devoluciones</span>
            </div>
            <div class="faq-text-box">
              <h3>Políticas de devolución</h3>
              <p>
                Si tu artículo presenta algún defecto, tienes hasta 15 días para solicitar un cambio o reembolso, sin
                complicaciones.
              </p>
            </div>
          </div>

          <!-- Delivery -->
          <div class="faq-row">
            <div class="faq-icon-box">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Delivery</span>
            </div>
            <div class="faq-text-box">
              <h3>Envíos y entregas</h3>
              <p>
                Hacemos envíos rápidos en 24-48 horas a toda la zona metropolitana, y envíos regulares al resto del
                país.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .contact-page-wrapper {
    max-width: 100%;
    margin: 0;
    padding: 100px 0 0;
  }
  .contact-layout-grid {
    display: flex;
    width: 100%;
    align-items: stretch;
  }
  .contact-breadcrumb {
    padding: 0 0 20px 48px;
  }
  .contact-layout-left {
    width: 55%;
    padding-left: 48px;
    padding-right: 48px;
  }
  .contact-layout-right {
    width: 45%;
    padding-left: 24px;
    padding-right: 48px;
    display: flex;
    flex-direction: column;
  }
  .contact-inner-left {
    max-width: 750px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .contact-inner-right {
    max-width: 600px;
    margin: 0 auto;
  }
  @media (max-width: 960px) {
    .contact-page-wrapper {
      padding: 100px 0 0;
    }
    .contact-layout-grid {
      flex-direction: column;
      gap: 60px;
    }
    .contact-layout-left,
    .contact-layout-right {
      width: 100%;
      padding-left: 20px;
      padding-right: 20px;
    }
    .contact-inner-left,
    .contact-inner-right {
      max-width: 100%;
      margin: 0 auto;
    }
  }

  /* Estilos para el nuevo bloque FAQ */
  .faq-row {
    display: flex;
    gap: 16px;
    align-items: center;
    position: relative;
    min-height: 139px;
  }

  .faq-icon-box {
    width: 230px;
    height: 139px;
    flex-shrink: 0;
    background: #f8fafc;
    border-radius: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #919191;
    padding: 10px;
    transition: all 0.2s;
    cursor: pointer;
    position: absolute;
    left: -260px;
    top: 50%;
    transform: translateY(-50%);
  }

  .faq-icon-box:hover,
  .faq-icon-box.active {
    background: #dc2626;
    color: #fff;
  }

  .faq-icon-box span {
    font-weight: 800;
    font-size: 0.9rem;
  }

  .faq-text-box {
    flex: 1;
    height: 139px;
    background: transparent;
    border: 1px solid #e2e8f0;
    border-radius: 30px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: all 0.2s;
  }

  .faq-text-box h3 {
    color: #A72323;
    margin: 0 0 8px 0;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .faq-text-box p {
    color: #111;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .contact-layout-grid {
      flex-direction: column;
      gap: 60px;
    }
    .contact-layout-left,
    .contact-layout-right {
      width: 100%;
      padding-left: 20px;
      padding-right: 20px;
    }
    .contact-breadcrumb {
      padding-left: 20px;
    }
    .faq-icon-box {
      position: static;
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .faq-row {
      flex-direction: column;
      gap: 12px;
      min-height: auto;
    }
    .faq-icon-box {
      width: 100%;
      flex-direction: row;
      justify-content: flex-start;
      padding: 16px 20px;
      height: auto;
      position: static;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp",
      "label": "Número de WhatsApp",
      "default": "+1 (809) 326-9319"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Correo de contacto",
      "default": "soporte@elcarterord.store"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Horario de atención",
      "default": "Lun–Sáb: 9am–7pm\nDom: 10am–4pm"
    }
  ]
}
{% endschema %}
