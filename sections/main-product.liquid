  <img id="ecr-lightbox-img" src="{{ 'favicon.svg' | asset_url }}" alt="Reseña Foto" width="800" height="800" loading="lazy" onclick="event.stopPropagation()">
</div>

<script>
  function ecrOpenAllReviews() {
    document.getElementById('ecr-all-reviews-overlay').classList.add('ecr-open');
    document.body.style.overflow = 'hidden';
  }

  function ecrCloseAllReviews() {
    document.getElementById('ecr-all-reviews-overlay').classList.remove('ecr-open');
    document.body.style.overflow = '';
  }

  function ecrHandleAllReviewsOverlayClick(e) {
    if (e.target === document.getElementById('ecr-all-reviews-overlay')) ecrCloseAllReviews();
  }

  let ecrSelectedStars = 0;

  function ecrOpenModal() {
    document.getElementById('ecr-modal-overlay').classList.add('ecr-open');
    document.body.style.overflow = 'hidden';
  }

  function ecrCloseModal() {
    document.getElementById('ecr-modal-overlay').classList.remove('ecr-open');
    document.body.style.overflow = '';
  }

  function ecrHandleOverlayClick(e) {
    if (e.target === document.getElementById('ecr-modal-overlay')) ecrCloseModal();
  }

  function ecrSetStars(val) {
    ecrSelectedStars = val;
    document.querySelectorAll('.ecr-star-pick').forEach(s => {
      const isActive = parseInt(s.dataset.val) <= val;
      s.classList.toggle('ecr-active', isActive);
      s.textContent = isActive ? '★' : '☆';
    });
  }

  function ecrOpenImageModal(src) {
    document.getElementById('ecr-lightbox-img').src = src;
    document.getElementById('ecr-image-overlay').classList.add('ecr-open');
    document.body.style.overflow = 'hidden';
  }

  function ecrCloseImageModal() {
    document.getElementById('ecr-image-overlay').classList.remove('ecr-open');
    document.body.style.overflow = '';
  }

  function ecrPreviewPhoto(e) {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      const img = document.getElementById('ecr-upload-preview');
      img.src = ev.target.result;
      img.style.display = 'block';
      document.querySelector('.ecr-upload-icon').style.display = 'none';
    };
    reader.readAsDataURL(file);
  }

  const CLOUDINARY_URL = 'https://api.cloudinary.com/v1_1/dpcza3euo/image/upload';
  const CLOUDINARY_PRESET = 'naa15md7';
  const SUPABASE_URL = 'https://dbtuzdfejaakbuuoumse.supabase.co/rest/v1/Reviews';
  const SUPABASE_KEY = 'sb_publishable_JL0Rq_GjdJZclca_xv22Dg_UqArwoIz';

  async function ecrSubmitReview() {
    const errorEl = document.getElementById('ecr-submit-error');
    errorEl.style.display = 'none';
    
    const nombre = document.getElementById('ecr-input-name').value.trim();
    const producto = document.getElementById('ecr-input-product').value.trim();
    const texto = document.getElementById('ecr-input-text').value.trim();
    const photoInput = document.getElementById('ecr-photo-input');
    const file = photoInput.files[0];

    if (!nombre || !producto || !texto || ecrSelectedStars === 0) {
      errorEl.textContent = 'Por favor, completa todos los campos obligatorios y tu calificación.';
      errorEl.style.display = 'block';
      return;
    }

    const btn = document.querySelector('.ecr-btn-submit');
    btn.textContent = 'Enviando...';
    btn.style.opacity = '0.7';
    btn.style.cursor = 'not-allowed';
    btn.disabled = true;

    try {
      let foto_url = null;

      // Subir foto a Cloudinary si hay
      if (file) {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('upload_preset', CLOUDINARY_PRESET);

        const cloudRes = await fetch(CLOUDINARY_URL, {
          method: 'POST',
          body: formData
        });
        const cloudData = await cloudRes.json();
        
        if (cloudData.secure_url) {
          foto_url = cloudData.secure_url;
        } else {
          throw new Error('Error Cloudinary: ' + JSON.stringify(cloudData));
        }
      }

      // Guardar en Supabase
      const reviewData = {
        nombre: nombre,
        producto: producto,
        estrellas: ecrSelectedStars,
        texto: texto,
        foto_url: foto_url,
        verificado: false
      };

      const supaRes = await fetch(SUPABASE_URL, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': 'Bearer ' + SUPABASE_KEY,
          'Content-Type': 'application/json',
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(reviewData)
      });

      if (!supaRes.ok) {
        const errData = await supaRes.text();
        throw new Error('Error en BD: ' + errData);
      }

      // Exito
      alert('¡Gracias por tu reseña! La revisaremos pronto 🎉');
      
      // Limpiar form
      document.getElementById('ecr-input-name').value = '';
      document.getElementById('ecr-input-text').value = '';
      photoInput.value = '';
      document.getElementById('ecr-upload-preview').style.display = 'none';
      document.querySelector('.ecr-upload-icon').style.display = 'block';
      ecrSetStars(0);

      ecrCloseModal();
      
      // Reload reviews to show immediately
      ecrLoadSupabaseReviews();

    } catch (err) {
      console.error(err);
      errorEl.textContent = 'Error: ' + err.message;
      errorEl.style.display = 'block';
    } finally {
      btn.textContent = 'Publicar reseña';
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
      btn.disabled = false;
    }
  }

  function ecrTimeAgo(dateStr) {
    if (!dateStr) return 'Reciente';
    const date = new Date(dateStr);
    if (isNaN(date.getTime())) return 'Reciente';
    
    const seconds = Math.floor((new Date() - date) / 1000);
    let interval = seconds / 31536000;
    if (interval > 1) return "hace " + Math.floor(interval) + (Math.floor(interval) === 1 ? " año" : " años");
    interval = seconds / 2592000;
    if (interval > 1) return "hace " + Math.floor(interval) + (Math.floor(interval) === 1 ? " mes" : " meses");
    interval = seconds / 604800;
    if (interval >= 1) return "hace " + Math.floor(interval) + (Math.floor(interval) === 1 ? " semana" : " semanas");
    interval = seconds / 86400;
    if (interval >= 1) return "hace " + Math.floor(interval) + (Math.floor(interval) === 1 ? " día" : " días");
    interval = seconds / 3600;
    if (interval >= 1) return "hace " + Math.floor(interval) + (Math.floor(interval) === 1 ? " hora" : " horas");
    interval = seconds / 60;
    if (interval >= 1) return "hace " + Math.floor(interval) + (Math.floor(interval) === 1 ? " minuto" : " minutos");
    return "hace un momento";
  }

  async function ecrLoadSupabaseReviews() {
    try {
      const productTitle = "{{ product.title | escape }}";
      // Se piden TODAS las reseñas de este producto
      const url = SUPABASE_URL + '?producto=eq.' + encodeURIComponent(productTitle) + '&order=id.desc';
      
      const res = await fetch(url, {
        method: 'GET',
        headers: {
          'apikey': SUPABASE_KEY,
          'Authorization': 'Bearer ' + SUPABASE_KEY
        }
      });
      
      if (!res.ok) return;
      const reviews = await res.json();
      
      if (reviews && reviews.length > 0) {
        const renderCards = (revs) => {
          return revs.map(r => {
            let initials = r.nombre ? r.nombre.substring(0, 2).toUpperCase() : 'AN';
            let photoHtml = r.foto_url 
              ? `<img class="ecr-card-photo" src="${r.foto_url}" style="width:100%; height:auto; aspect-ratio:1/1; object-fit:cover; cursor:zoom-in;" onclick="ecrOpenImageModal('${r.foto_url}')">`
              : `<div class="ecr-card-photo-placeholder" style="background:var(--gray-100); color:var(--gray-500); display:flex; align-items:center; justify-content:center; width:100%; aspect-ratio:1/1;">📦</div>`;
            
            let starsHtml = '';
            for (let i=1; i<=5; i++) {
              starsHtml += i <= (r.estrellas || 5) ? '<span class="ecr-star ecr-filled">★</span>' : '<span class="ecr-star">★</span>';
            }

            return `
              <div class="ecr-card">
                ${photoHtml}
                <div class="ecr-card-body">
                  <div class="ecr-card-top">
                    <div class="ecr-card-avatar" style="background:var(--dark); color:white;">${initials}</div>
                    <div class="ecr-card-meta">
                      <div class="ecr-card-name">${r.nombre || 'Anónimo'}</div>
                      <div class="ecr-card-date">${ecrTimeAgo(r.created_at)}</div>
                    </div>
                    <span class="ecr-verified">✓ Verificado</span>
                  </div>
                  <div class="ecr-card-stars ecr-stars">${starsHtml}</div>
                  <div class="ecr-card-product">${r.producto}</div>
                  <p class="ecr-card-text">${r.texto || ''}</p>
                </div>
              </div>
            `;
          }).join('');
        };

        const mainGrid = document.querySelector('.ecr-reviews-grid');
        const modalGrid = document.querySelector('.ecr-all-reviews-list');

        if (mainGrid) {
          mainGrid.innerHTML = renderCards(reviews.slice(0, 6));
        }
        if (modalGrid) {
          modalGrid.innerHTML = renderCards(reviews);
        }
        
        const viewAllBtn = document.getElementById('ecr-btn-view-all');
        if (viewAllBtn) {
          viewAllBtn.style.display = reviews.length > 6 ? 'inline-flex' : 'none';
        }
        
        // Calculate dynamic stats
        let totalStars = 0;
        let counts = { 5:0, 4:0, 3:0, 2:0, 1:0 };
        let satisfiedCount = 0;
        
        reviews.forEach(r => {
          const s = r.estrellas || 5;
          totalStars += s;
          counts[s] = (counts[s] || 0) + 1;
          if (s >= 4) satisfiedCount++;
        });
        
        const avgScore = (totalStars / reviews.length).toFixed(1);
        const satisfiedPercent = Math.round((satisfiedCount / reviews.length) * 100);
        
        // Update avg score
        const avgScoreEl = document.querySelector('.ecr-big');
        if (avgScoreEl) avgScoreEl.textContent = avgScore;
        
        // Update avg stars
        const avgStarsEl = document.querySelector('.ecr-summary-score .ecr-stars');
        if (avgStarsEl) {
           let starsHtml = '';
           for(let i=1; i<=5; i++) {
             starsHtml += i <= Math.round(avgScore) ? '<span class="ecr-star ecr-filled">★</span>' : '<span class="ecr-star">★</span>';
           }
           avgStarsEl.innerHTML = starsHtml;
        }
        
        // Update bars
        const barsEl = document.querySelector('.ecr-summary-bars');
        if (barsEl) {
           let barsHtml = '';
           for(let i=5; i>=1; i--) {
              let percent = Math.round((counts[i] / reviews.length) * 100) || 0;
              barsHtml += `<div class="ecr-bar-row"><span class="ecr-bar-label">${i}</span><div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:${percent}%"></div></div><span class="ecr-bar-count">${counts[i]}</span></div>`;
           }
           barsEl.innerHTML = barsHtml;
        }

        const summaryCount = document.querySelector('.ecr-count');
        if (summaryCount) summaryCount.innerHTML = `Basado en ${reviews.length} reseñas`;
        
        const badgeNum = document.querySelector('.ecr-badge-num');
        if (badgeNum) badgeNum.innerHTML = reviews.length > 0 ? satisfiedPercent + '%' : '0%';
        
        const badgeText = document.querySelector('.ecr-badge-text');
        if (badgeText) badgeText.innerHTML = `satisfechos`;
        
        // Update top product stars
        const topStarsEl = document.getElementById('top-rating-stars');
        if (topStarsEl) {
           let topStarsHtml = '';
           for(let i=1; i<=5; i++) {
             topStarsHtml += i <= Math.round(avgScore) ? '<span style="color:#F5A623">★</span>' : '<span style="color:#ddd">★</span>';
           }
           topStarsEl.innerHTML = topStarsHtml;
        }
        
        const topLinkEl = document.getElementById('top-rating-link');
        if (topLinkEl) topLinkEl.textContent = `Ver ${reviews.length} reseñas →`;
      }
    } catch (e) {
      console.error('Error fetching reviews:', e);
    }
  }

  document.addEventListener("DOMContentLoaded", ecrLoadSupabaseReviews);
</script>
  </div>
</div>

<!-- PRODUCTOS DE LA MISMA CATEGORÍA -->
{% if product.type != blank %}
  <div class="products-wrap related-wrapper" style="margin-top: 60px;">
    <div class="row-header reveal" style="opacity: 1; transform: none; margin-bottom: 32px;">
      <div>
        <p class="section-eyebrow">Relacionados</p>
        <h2 class="section-title">
          Más de <span style="color:var(--red);">{{ product.type }}</span>
        </h2>
      </div>
    </div>
    <div class="prods-grid related-grid">
      {% assign count = 0 %}
      {% paginate collections.all.products by 250 %}
        {% for related in collections.all.products %}
          {% if related.type == product.type and related.id != product.id %}
            {% assign count = count | plus: 1 %}
            <div class="prod reveal d{{ count | modulo: 4 | plus: 1 }}" style="position:relative;">
              <a
                href="{{ related.url }}"
                style="position:absolute;inset:0;z-index:1;"
                aria-label="{{ related.title | escape }}"
              ></a>
              <div class="prod-thumb" style="background: #ffffff;">
                {% if related.featured_image %}
                  <img
                    src="{{ related.featured_image | image_url: width: 600 }}"
                    alt="{{ related.title }}"
                    width="600"
                    height="600"
                    loading="lazy"
                    style="width:100%; height:100%; object-fit:contain; display:block;"
                  >
                {% else %}
                  <span></span>
                {% endif %}
                {% if related.compare_at_price > related.price %}
                  <span class="prod-label lb-hot">Oferta</span>
                {% endif %}
                <button
                  class="prod-wish-btn"
                  data-wish-id="{{ related.id }}"
                  data-wish-title="{{ related.title | escape }}"
                  data-wish-img="{% if related.featured_image %}{{ related.featured_image | image_url: width: 400 }}{% endif %}"
                  data-wish-price="{{ related.price | money }}"
                  data-wish-url="{{ related.url }}"
                  onclick="event.stopPropagation(); toggleWish(this)"
                  aria-label="Guardar en favoritos"
                >
                  ♡
                </button>
              </div>
              <div class="prod-info">
                <a href="{{ related.url }}" style="text-decoration:none; color:inherit;">
                  <p class="prod-name" style="margin-bottom:8px;">{{ related.title }}</p>
                </a>
                <div class="prod-bottom amazon-style">
                  <div class="prod-price-block">
                    {% if related.compare_at_price > related.price %}
                      <span class="prod-price-old">{{ related.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="prod-price-now">{{ related.price | money }}</span>
                  </div>
                  <p class="prod-shipping">Envío GRATIS</p>
                  <form
                    method="post"
                    action="{{ routes.cart_add_url }}"
                    class="ajax-cart-form"
                    style="margin:0;width:100%;position:relative;z-index:2;"
                  >
                    <input type="hidden" name="id" value="{{ related.variants.first.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <div class="prod-actions">
                      <button
                        type="submit"
                        name="add"
                        class="prod-cart-btn"
                        {% unless related.available %}
                          disabled
                        {% endunless %}
                        title="Agregar al carrito"
                      >
                        Carrito
                      </button>

                    </div>
                  </form>
                </div>
              </div>
            </div>
            {% if count == 10 %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endpaginate %}
    </div>
    {% if count == 0 %}
      <p style="color:var(--muted); font-size:0.9rem;">No hay más productos en esta categoría por el momento.</p>
    {% endif %}
  </div>
  <style>
    .related-grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 24px;
      gap: 20px;
    }
    .related-grid::-webkit-scrollbar {
      height: 8px;
    }
    .related-grid::-webkit-scrollbar-track {
      background: transparent;
    }
    .related-grid::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .related-grid::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    .related-grid .prod {
      flex: 0 0 calc(25% - 15px) !important;
      scroll-snap-align: start;
    }

    @media (max-width: 960px) {
      .related-wrapper {
        padding: 0 20px !important;
      }
      .related-grid .prod {
        flex: 0 0 calc(45% - 10px) !important;
      }
    }
    @media (max-width: 500px) {
      .related-grid .prod {
        flex: 0 0 calc(75% - 10px) !important;
      }
    }

    /* Trust Chips Styling */
    .trust-row {
      display: flex !important;
      gap: 12px !important;
      flex-wrap: wrap !important;
      margin-top: 24px !important;
      margin-bottom: 24px !important;
      width: 100% !important;
    }

    .trust-chip {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      background: var(--white, #ffffff) !important;
      border: 1.5px solid var(--sand, #e2e8f0) !important;
      border-radius: 14px !important;
      padding: 12px 16px !important;
      flex: 1 !important;
      min-width: 120px !important;
      box-shadow: var(--shadow) !important;
      justify-content: flex-start !important;
    }

    .trust-chip-icon {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: #dc2626 !important; /* brand red */
      flex-shrink: 0 !important;
      width: 24px !important;
      height: 24px !important;
    }

    .trust-chip-icon svg {
      width: 24px !important;
      height: 24px !important;
      display: block !important;
    }

    .trust-chip-text {
      font-size: 0.72rem !important;
      font-weight: 600 !important;
      color: var(--dark, #0f172a) !important;
      line-height: 1.4 !important;
      text-align: left !important;
    }

    @media (max-width: 960px) {
      .trust-row {
        gap: 8px !important;
      }
      .trust-chip {
        padding: 10px 12px !important;
      }
    }

    @media (max-width: 480px) {
      .trust-chip-text {
        font-size: 0.68rem !important;
      }
    }
  </style>
{% endif %}

<script>

// ── Cambio de imagen por thumbnail ──
function setThumb(el, imageUrl) {
  document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  const mainImage = document.getElementById('FeaturedImage');
  if (mainImage) {
    mainImage.style.opacity = '0';
    setTimeout(() => {
      mainImage.src = imageUrl;
      mainImage.style.opacity = '1';
    }, 150);
  }
}

// Transición suave de imagen
const fi = document.getElementById('FeaturedImage');
if (fi) fi.style.transition = 'opacity 0.2s ease';

// ── Cambio de tabs ──
function setTab(btn, id) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('panel-' + id).classList.add('active');
}

// ── Datos de variantes (inyectados server-side) ──
const _productVariants = {{ product.variants | json }};
const _productOptions  = {{ product.options | json }};

// ── Selección de variante ──
function selectOpt(label, optName, value) {
  // Desmarcar hermanos
  const group = label.closest('.color-opts');
  group.querySelectorAll('.color-dot').forEach(l => l.classList.remove('selected'));
  label.classList.add('selected');
  // Actualizar label visible del nombre de opción
  const nameEl = document.getElementById(optName + '-Name');
  if (nameEl) nameEl.textContent = value;
  // Sincronizar el <select> oculto con la variante correspondiente
  _updateSelectedVariant();
}

function _updateSelectedVariant() {
  const selectedVals = _productOptions.map((name) => {
    const checked = document.querySelector(`input[name="${name}"]:checked`);
    return checked ? checked.value : null;
  });
  const match = _productVariants.find(v =>
    _productOptions.every((name, idx) => v['option' + (idx + 1)] === selectedVals[idx])
  );
  if (!match) return;
  // Actualizar el select oculto que Shopify usa al enviar el form
  const sel = document.getElementById('productSelect');
  if (sel) sel.value = match.id;
  // Actualizar disponibilidad del botón de agregar al carrito
  const addBtn  = document.getElementById('AddToCart');
  const addText = document.getElementById('AddToCartText');
  if (addBtn) {
    addBtn.disabled = !match.available;
    if (addText) addText.textContent = match.available ? 'Agregar al carrito' : 'Agotado';
  }
}

// ── Feedback visual del botón Agregar al carrito ──
const cartForm = document.getElementById('AddToCartForm');
if (cartForm) {
  cartForm.addEventListener('submit', function() {
    const btn  = document.getElementById('AddToCart');
    const text = document.getElementById('AddToCartText');
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    text.textContent = '¡Agregado!';
    btn.style.background = 'var(--red)';
    setTimeout(() => {
      btn.disabled = false;
      text.textContent = 'Agregar al carrito';
      btn.style.background = '';
    }, 2500);
  });
}

// ── Sincronizar estado del botón de favoritos al cargar ──
(function() {
  const btn = document.getElementById('WishBtn');
  if (!btn) return;
  const id = btn.dataset.wishId;
  let list = [];
  try { list = JSON.parse(localStorage.getItem('elcartero_wishlist') || '[]'); } catch(e) {}
  if (list.some(p => String(p.id) === String(id))) {
    btn.classList.add('wished');
    btn.textContent = '♥';
  }
})();

// ── Selector de estrellas para reseñas ──
function setReviewStar(val) {
  document.getElementById('rStars').value = val;
  document.querySelectorAll('#starPicker span').forEach(s => {
    s.style.color = parseInt(s.dataset.val) <= val ? '#f5b800' : 'var(--sand)';
  });
}

// ── Enviar reseña ──
function enviarResena() {
  const nombre = document.getElementById('rNombre').value.trim();
  const stars = document.getElementById('rStars').value;
  const comentario = document.getElementById('rComentario').value.trim();
  if (!nombre || stars === '0' || !comentario) {
    alert('Por favor completa todos los campos y selecciona una calificación.');
    return;
  }
  const toast = document.getElementById('toast');
  if (toast) {
    toast.textContent = '¡Gracias por tu reseña!';
    toast.className = 'toast show';
    setTimeout(() => toast.classList.remove('show'), 3500);
  }
  document.getElementById('rNombre').value = '';
  document.getElementById('rComentario').value = '';
  setReviewStar(0);
}
</script>

