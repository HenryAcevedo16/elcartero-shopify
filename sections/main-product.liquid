<div class="breadcrumb">
  <a href="{{ routes.root_url }}">Inicio</a><span>›</span>
  {% if collection %}
    <a href="{{ collection.url }}">{{ collection.title }}</a><span>›</span>
  {% else %}
    <a href="{{ routes.all_products_collection_url }}">Catálogo</a><span>›</span>
  {% endif %}
  <span class="current">{{ product.title }}</span>
</div>

<!-- PRODUCT -->
<div class="product-section">
  <!-- GALLERY -->
  <div class="gallery reveal">
    <div class="gallery-main">
      <div class="gm-bg" id="mainImg">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 1024 }}"
            alt="{{ product.title }}"
            width="1024"
            height="1024"
            style="width:100%; height:100%; object-fit:contain;"
            id="FeaturedImage"
          >
        {% else %}
          <span id="mainEmoji"></span>
        {% endif %}
      </div>
      {% if product.compare_at_price > product.price %}
        <span class="gm-label">Oferta</span>
      {% endif %}
      <button
        type="button"
        class="gm-wish-btn"
        id="WishBtn"
        data-wish-id="{{ product.id }}"
        data-wish-title="{{ product.title | escape }}"
        data-wish-img="{% if product.featured_image %}{{ product.featured_image | image_url: width: 400 }}{% endif %}"
        data-wish-price="{{ product.price | money }}"
        data-wish-url="{{ product.url }}"
        onclick="toggleWish(this)"
        aria-label="Guardar en favoritos"
      >
        ♡
      </button>
    </div>

    {% if product.images.size > 1 %}
      <div class="gallery-thumbs">
        {% for image in product.images %}
          <div
            class="thumb thumb-bg{{ forloop.index | modulo: 4 | plus: 1 }} {% if forloop.first %}active{% endif %}"
            onclick="setThumb(this, '{{ image | image_url: width: 1024 }}')"
          >
            <img
              src="{{ image | image_url: width: 160 }}"
              alt="{{ product.title }}"
              width="160"
              height="160"
              loading="lazy"
              style="width:100%; height:100%; object-fit:contain; border-radius:10px;"
            >
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- INFO PANEL -->
  <div class="reveal d1">
    <div class="prod-badges">
      <span class="pbadge pb-elec">{{ product.type | default: 'Producto' }}</span>
      {% if product.available %}
        <span class="pbadge pb-stock">En stock</span>
      {% else %}
        <span class="pbadge pb-new" style="background:var(--muted)">Agotado</span>
      {% endif %}
    </div>

    <h1 class="prod-title">{{ product.title }}</h1>

    <div class="prod-rating-row">
      <span class="rating-stars" id="top-rating-stars" style="color:#ddd; display:inline-flex; gap:2px;">★★★★★</span>
      <a href="#reviews" class="rating-link" id="top-rating-link">Sé el primero en opinar</a>
    </div>

    <div class="price-block">
      <div>
        {% if product.compare_at_price > product.price %}
          <div class="price-old">{{ product.compare_at_price | money }}</div>
        {% endif %}
        <div class="price-now">{{ product.price | money }}</div>
      </div>
      {% if product.compare_at_price > product.price %}
        <div class="price-save">Oferta Especial</div>
      {% endif %}
    </div>

    <div class="section-divider"></div>

    <form
      action="{{ routes.cart_add_url }}"
      method="post"
      enctype="multipart/form-data"
      id="AddToCartForm"
      class="ajax-cart-form"
      data-type="pdp"
    >
      <!-- Variantes Selector Oculto usado por Shopify -->
      <select name="id" id="productSelect" style="display:none;">
        {% for variant in product.variants %}
          {% if variant.available %}
            <option value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money_with_currency }}</option>
          {% else %}
            <option disabled="disabled">{{ variant.title }} - Agotado</option>
          {% endif %}
        {% endfor %}
      </select>

      <!-- Si el producto tiene múltiples opciones de variantes (ej: Color y Tamaño) -->
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <div class="variant-wrapper" style="margin-bottom: 24px;">
            <p class="opt-label" style="margin-top:4px;">
              {{ option.name }}:
              <strong style="color:var(--dark);text-transform:none;letter-spacing:0;" id="{{ option.name }}-Name">
                {{- option.values.first -}}
              </strong>
            </p>
            <div class="color-opts" id="opts-{{ option.name | handleize }}">
              {% for value in option.values %}
                <label
                  class="color-dot {% if forloop.first %}selected{% endif %}"
                  style="background: var(--sand); display:flex; justify-content:center; align-items:center;"
                  onclick="selectOpt(this, '{{ option.name | escape }}', '{{ value | escape }}')"
                >
                  <input
                    type="radio"
                    value="{{ value | escape }}"
                    name="{{ option.name }}"
                    {% if forloop.first %}
                      checked
                    {% endif %}
                    style="display:none;"
                  >
                  <span style="font-size: 0.6rem; font-weight:700;">{{ value | slice: 0, 3 }}</span>
                </label>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% endunless %}

      <!-- Quantity -->
      <div class="qty-row">
        <span class="qty-label">Cantidad</span>
        <div class="qty-ctrl">
          <button type="button" class="qty-btn" onclick="var q=document.getElementById('Quantity'); q.stepDown(); q.setAttribute('value', q.value);">−</button>
          <input
            type="number"
            id="Quantity"
            name="quantity"
            value="1"
            min="1"
            class="qty-num"
            onchange="this.setAttribute('value', this.value);"
            style="min-width:40px; text-align:center; font-size:.9rem; font-weight:700; border:none; outline:none; -moz-appearance:textfield;"
          >
          <button type="button" class="qty-btn" onclick="var q=document.getElementById('Quantity'); q.stepUp(); q.setAttribute('value', q.value);">+</button>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="action-btns">
        <button
          type="submit"
          name="add"
          id="AddToCart"
          class="btn-addcart"
          {% unless product.available %}
            disabled="disabled"
          {% endunless %}
        >
          <span id="AddToCartText">
            {% if product.available %}Agregar al carrito{% else %}Agotado{% endif %}
          </span>
        </button>


      </div>
    </form>

    <!-- Trust -->
    <div class="trust-row">
      <div class="trust-chip">
        <span class="trust-chip-icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </span>
        <span class="trust-chip-text">
          Envío gratis<br>a tu puerta
        </span>
      </div>

      <div class="trust-chip">
        <span class="trust-chip-icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 14 4 9 9 4"></polyline>
            <path d="M20 20v-7a4 4 0 0 0-4-4H4"></path>
          </svg>
        </span>
        <span class="trust-chip-text">
          Devolución<br>30 días
        </span>
      </div>

      <div class="trust-chip">
        <span class="trust-chip-icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M6 12h.01M18 12h.01"></path>
          </svg>
        </span>
        <span class="trust-chip-text">
          Pago contra<br>entrega
        </span>
      </div>
    </div>
  </div>
</div>

<!-- TABS (Extractos dinámicos del producto) -->
<div class="tabs-section">
  <div class="tabs-header">
    <button class="tab-btn active" onclick="setTab(this,'desc')">Descripción</button>

    <button class="tab-btn" onclick="setTab(this,'reviews')" id="reviewsTab">Reseñas</button>
  </div>

  <div class="tab-panel active" id="panel-desc">
    <div class="desc-grid">
      <div class="desc-text" style="font-size: .9rem; line-height: 1.8; color: var(--muted); margin-bottom: 16px;">
        {{ product.description }}
      </div>
    </div>
  </div>



  <div class="tab-panel" id="panel-reviews">
<style>
  .ecr-reviews-section {
    --red: #D62828;
    --dark: #12192B;
    --white: #ffffff;
    --gray-50: #f9f9f9;
    --gray-100: #f2f2f2;
    --gray-300: #d1d1d1;
    --gray-500: #888;
    --gray-700: #444;
    --star: #F5A623;
    --radius: 16px;
    font-family: 'Poppins', sans-serif;
    background: var(--white);
    color: var(--dark);
    padding: 30px 0;
  }
  .ecr-reviews-section *, .ecr-reviews-section *::before, .ecr-reviews-section *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* Header */
  .ecr-section-label { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  .ecr-section-label::before { content: ''; display: block; width: 28px; height: 2px; background: var(--red); border-radius: 2px; }
  .ecr-section-title { font-size: clamp(26px, 4vw, 38px); font-weight: 800; color: var(--dark); line-height: 1.1; margin-bottom: 6px; }
  .ecr-section-title span { color: var(--red); }
  .ecr-section-sub { font-size: 14px; color: var(--gray-500); margin-bottom: 36px; }

  /* Summary */
  .ecr-summary { display: flex; align-items: center; gap: 28px; background: var(--gray-50); border: 1px solid var(--gray-100); border-radius: var(--radius); padding: 20px 28px; margin-bottom: 36px; flex-wrap: wrap; }
  .ecr-summary-score { text-align: center; min-width: 70px; }
  .ecr-summary-score .ecr-big { font-size: 44px; font-weight: 800; color: var(--dark); line-height: 1; }
  .ecr-summary-score .ecr-stars-row { margin: 4px 0 2px; }
  .ecr-summary-score .ecr-count { font-size: 12px; color: var(--gray-500); }
  .ecr-summary-divider { width: 1px; height: 56px; background: var(--gray-300); }
  .ecr-summary-bars { flex: 1; min-width: 200px; }
  .ecr-bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; }
  .ecr-bar-label { font-size: 11px; font-weight: 600; color: var(--gray-700); width: 16px; text-align: right; }
  .ecr-bar-track { flex: 1; height: 5px; background: var(--gray-100); border-radius: 99px; overflow: hidden; }
  .ecr-bar-fill { height: 100%; background: var(--star); border-radius: 99px; transition: width 0.8s ease; }
  .ecr-bar-count { font-size: 11px; color: var(--gray-500); width: 20px; }
  .ecr-summary-badge { background: var(--dark); color: var(--white); border-radius: 12px; padding: 14px 20px; text-align: center; min-width: 130px; }
  .ecr-summary-badge .ecr-badge-num { font-size: 22px; font-weight: 800; display: block; }
  .ecr-summary-badge .ecr-badge-text { font-size: 11px; opacity: 0.6; margin-top: 2px; }

  /* Stars */
  .ecr-stars { display: flex; gap: 2px; }
  .ecr-star { font-size: 14px; color: var(--gray-300); }
  .ecr-star.ecr-filled { color: var(--star); }

  /* Grid */
  .ecr-reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 900px) { .ecr-reviews-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .ecr-reviews-grid { grid-template-columns: 1fr; } }

  /* Card */
  .ecr-card { display: flex; flex-direction: column; break-inside: avoid; background: var(--white); border: 1px solid var(--gray-100); border-radius: var(--radius); overflow: hidden; margin-bottom: 0; transition: box-shadow 0.25s ease, transform 0.25s ease; cursor: default; height: 100%; }
  .ecr-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.09); transform: translateY(-3px); }
  .ecr-card-photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; background: var(--gray-100); }
  .ecr-card-photo-placeholder { width: 100%; aspect-ratio: 1 / 1; background: var(--gray-100); display: flex; align-items: center; justify-content: center; font-size: 36px; color: var(--gray-300); }
  .ecr-card-body { padding: 16px; display: flex; flex-direction: column; flex: 1; }
  .ecr-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .ecr-card-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--red); color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .ecr-card-meta { flex: 1; margin-left: 10px; }
  .ecr-card-name { font-size: 13px; font-weight: 700; color: var(--dark); line-height: 1.2; }
  .ecr-card-date { font-size: 11px; color: var(--gray-500); margin-top: 1px; }
  .ecr-verified { display: flex; align-items: center; gap: 3px; font-size: 10px; font-weight: 600; color: #16a34a; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 3px 7px; border-radius: 99px; white-space: nowrap; }
  .ecr-card-stars { margin-bottom: 8px; }
  .ecr-card-product { font-size: 11px; font-weight: 600; color: var(--red); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
  .ecr-card-text { font-size: 13px; color: var(--gray-700); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; flex: 1; }

  /* See All Reviews */
  .ecr-see-all-wrap { display: flex; justify-content: center; margin-top: 32px; width: 100%; }
  .ecr-btn-outline { display: inline-flex; align-items: center; justify-content: center; background: transparent; color: var(--dark); border: 2px solid var(--dark); font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 700; padding: 12px 32px; border-radius: 10px; cursor: pointer; transition: all 0.2s ease; width: 100%; max-width: 250px; }
  .ecr-btn-outline:hover { background: var(--dark); color: #fff; }

  /* Modal de Ver Todas */
  .ecr-all-reviews-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; overflow-y: auto; max-height: calc(90vh - 100px); padding: 4px; }
  .ecr-all-reviews-list .ecr-card { height: 100%; flex-direction: column; align-items: stretch; margin-bottom: 0; }
  .ecr-all-reviews-list .ecr-card-photo, .ecr-all-reviews-list .ecr-card-photo-placeholder { width: 100%; height: auto; aspect-ratio: 1 / 1; border-right: none; }
  .ecr-all-reviews-list .ecr-card-text { -webkit-line-clamp: unset; display: block; overflow: visible; }
  .ecr-modal-large { max-width: 1100px !important; width: 95% !important; max-height: 95vh; padding: 32px; }
  @media (max-width: 900px) {
    .ecr-all-reviews-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .ecr-all-reviews-list { grid-template-columns: 1fr; }
    .ecr-modal-large { padding: 20px; }
  }

  /* Write Review Button */
  .ecr-write-wrap { display: flex; justify-content: flex-end; margin-bottom: 24px; }
  .ecr-btn-write { display: inline-flex; align-items: center; gap: 8px; background: var(--white); color: var(--dark); border: 2px solid var(--dark); font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 700; padding: 10px 20px; border-radius: 10px; cursor: pointer; transition: all 0.2s ease; }
  .ecr-btn-write:hover { background: var(--dark); color: #fff; }

  /* Modal */
  .ecr-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 1000; align-items: center; justify-content: center; padding: 20px; }
  .ecr-modal-overlay.ecr-open { display: flex; }
  .ecr-modal { background: #fff; border-radius: 20px; padding: 32px; width: 100%; max-width: 480px; position: relative; animation: ecrPopIn 0.25s cubic-bezier(0.23,1,0.32,1); }
  @keyframes ecrPopIn { from { opacity: 0; transform: scale(0.92) translateY(16px); } to { opacity: 1; transform: scale(1) translateY(0); } }
  .ecr-modal-close { position: absolute; top: 16px; right: 16px; background: var(--gray-100); border: none; border-radius: 50%; width: 32px; height: 32px; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--gray-700); }
  
  .ecr-image-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 2000; align-items: center; justify-content: center; padding: 20px; }
  .ecr-image-overlay.ecr-open { display: flex; }
  .ecr-image-overlay img { max-width: 100%; max-height: 90vh; border-radius: 12px; object-fit: contain; }
  .ecr-image-close { position: absolute; top: 20px; right: 20px; background: none; border: none; color: #fff; font-size: 30px; cursor: pointer; }

  .ecr-modal-title { font-size: 20px; font-weight: 800; margin-bottom: 6px; }
  .ecr-modal-sub { font-size: 13px; color: var(--gray-500); margin-bottom: 24px; }
  .ecr-field-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--dark); margin-bottom: 6px; display: block; }
  .ecr-field-input, .ecr-field-textarea { width: 100%; font-family: 'Poppins', sans-serif; font-size: 14px; border: 1.5px solid var(--gray-300); border-radius: 10px; padding: 11px 14px; margin-bottom: 16px; outline: none; transition: border-color 0.2s; }
  .ecr-field-input:focus, .ecr-field-textarea:focus { border-color: var(--dark); }
  .ecr-field-textarea { resize: vertical; min-height: 90px; }
  
  .ecr-star-picker { display: flex; gap: 6px; margin-bottom: 16px; }
  .ecr-star-pick { font-size: 28px; cursor: pointer; color: var(--gray-300); transition: color 0.15s, transform 0.15s; line-height: 1; }
  .ecr-star-pick.ecr-active, .ecr-star-pick:hover { color: var(--star); transform: scale(1.15); }
  
  .ecr-upload-area { border: 2px dashed var(--gray-300); border-radius: 12px; padding: 20px; text-align: center; cursor: pointer; margin-bottom: 20px; transition: border-color 0.2s, background 0.2s; }
  .ecr-upload-area:hover { border-color: var(--dark); background: var(--gray-50); }
  .ecr-upload-icon { font-size: 28px; margin-bottom: 6px; }
  .ecr-upload-text { font-size: 13px; color: var(--gray-500); }
  .ecr-upload-text strong { color: var(--dark); }
  #ecr-photo-input { display: none; }
  .ecr-upload-preview { display: none; width: 80px; height: 80px; border-radius: 10px; object-fit: cover; margin: 0 auto 8px; }
  
  .ecr-btn-submit { width: 100%; background: var(--red); color: #fff; font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 700; padding: 14px; border: none; border-radius: 12px; cursor: pointer; transition: background 0.2s, transform 0.2s; }
  .ecr-btn-submit:hover { background: #b31f1f; transform: translateY(-1px); }
</style>

<div class="ecr-reviews-section">
  <!-- HEADER -->
  <div class="ecr-section-label">Opiniones verificadas</div>
  <div style="display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:4px;">
    <div>
      <h2 class="ecr-section-title">{{ section.settings.titulo_resenas | default: "Lo que dicen nuestros <span style='color:#D62828'>clientes</span>" }}</h2>
      <p class="ecr-section-sub">{{ section.settings.subtitulo_resenas | default: "Reseñas reales de personas que compraron en El Cartero RD" }}</p>
    </div>
    <div class="ecr-write-wrap" style="margin-bottom:0;">
      <button class="ecr-btn-write" onclick="ecrOpenModal()">✏️ Escribir reseña</button>
    </div>
  </div>

  <!-- SUMMARY -->
  <div class="ecr-summary">
    <div class="ecr-summary-score">
      <div class="ecr-big">0.0</div>
      <div class="ecr-stars-row">
        <div class="ecr-stars">
          <span class="ecr-star">★</span>
          <span class="ecr-star">★</span>
          <span class="ecr-star">★</span>
          <span class="ecr-star">★</span>
          <span class="ecr-star">★</span>
        </div>
      </div>
      <div class="ecr-count">Basado en 0 reseñas</div>
    </div>
    <div class="ecr-summary-divider"></div>
    <div class="ecr-summary-bars">
      <div class="ecr-bar-row"><span class="ecr-bar-label">5</span><div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:0%"></div></div><span class="ecr-bar-count">0</span></div>
      <div class="ecr-bar-row"><span class="ecr-bar-label">4</span><div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:0%"></div></div><span class="ecr-bar-count">0</span></div>
      <div class="ecr-bar-row"><span class="ecr-bar-label">3</span><div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:0%"></div></div><span class="ecr-bar-count">0</span></div>
      <div class="ecr-bar-row"><span class="ecr-bar-label">2</span><div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:0%"></div></div><span class="ecr-bar-count">0</span></div>
      <div class="ecr-bar-row"><span class="ecr-bar-label">1</span><div class="ecr-bar-track"><div class="ecr-bar-fill" style="width:0%"></div></div><span class="ecr-bar-count">0</span></div>
    </div>
    <div class="ecr-summary-divider"></div>
    <div class="ecr-summary-badge">
      <span class="ecr-badge-num">0%</span>
      <div class="ecr-badge-text">clientes satisfechos</div>
    </div>
  </div>

  <!-- GRID -->
  <div class="ecr-reviews-grid">
    {% assign has_reviews = false %}
    {% for block in section.blocks limit: 6 %}
      {% if block.type == 'review' %}
      {% assign has_reviews = true %}
      <div class="ecr-card" {{ block.shopify_attributes }}>
        {% if block.settings.imagen %}
